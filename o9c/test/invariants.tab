# Compiler/runtime semantic invariants covered by named mutation tests.
# Format: key=value fields parsed shell-style. Comma-separated tests and
# mutants must name checked-in files and tools/o9mutate.py mutant ids.

id=O9INV-PRIV-FIELD area=privacy rule="Private fields are only visible to the declaring class." behavior="'Counter.val' is private" tests=o9c/test/production_ast.rc,o9c/test/typecheck_bad_privfield_read.o9,o9c/test/typecheck_bad_privfield_write.o9 mutants=private_field_read gate=ast-test timeout=120
id=O9INV-PRIV-METHOD area=privacy rule="Private methods are only callable from the declaring class." behavior="'Counter.bump' is private" tests=o9c/test/production_ast.rc,o9c/test/typecheck_bad_private_call.o9 mutants=private_method_call gate=ast-test timeout=120
id=O9INV-TYPE-BOOL area=type-compatibility rule="Bool is not assignment-compatible with integer scalars." behavior="cannot initialize int64 to bool" tests=o9c/test/production_ast.rc,o9c/test/typecheck_bad_bool_int.o9 mutants=allow_bool_int_assignment gate=ast-test timeout=120
id=O9INV-CAST-SEMANTIC area=casts rule="Explicit casts are limited to scalar builtin values." behavior="cannot cast string/object to int64" tests=o9c/test/production_ast.rc,o9c/test/typecheck_bad_cast_string.o9,o9c/test/typecheck_bad_cast_object.o9 mutants=allow_nonscalar_cast gate=ast-test timeout=120
id=O9INV-CAST-WIDTH area=casts rule="Scalar casts lower through the target storage width." behavior="e2e cast and width output matches Plan 9 C width behavior" tests=o9c/test/run_e2e.rc,o9c/test/e2e_cast.o9,o9c/test/e2e_cast.expected,o9c/test/e2e_widths.o9,o9c/test/e2e_widths.expected mutants=weaken_cast_width_lowering gate=run-test:e2e_widths,e2e_cast timeout=180
id=O9INV-CHAN-SEND-ENDPOINT area=channels rule="Public recv-only channel endpoints reject sends." behavior="cannot send to recv-only channel" tests=o9c/test/production_ast.rc,o9c/test/typecheck_bad_recvonly_send.o9 mutants=send_to_recvonly gate=ast-test timeout=120
id=O9INV-CHAN-RECV-ENDPOINT area=channels rule="Public send-only channel endpoints reject receives." behavior="cannot receive from send-only channel" tests=o9c/test/production_ast.rc,o9c/test/typecheck_bad_sendonly_recv.o9,o9c/test/typecheck_bad_sendonly_alt.o9 mutants=recv_from_sendonly gate=ast-test timeout=120
id=O9INV-CHAN-DICT-PAYLOAD area=channels rule="Dict values are not channel payloads until ownership is defined." behavior="Dict values cannot be used as channel payloads yet" tests=o9c/test/production_ast.rc,o9c/test/typecheck_bad_chan_dict.o9 mutants=allow_dict_channel_payload gate=ast-test timeout=120
id=O9INV-TABULA-LOCALITY area=tabula rule="near/far/listener locality applies only to tabula data." behavior="remote objects are not supported" tests=o9c/test/production_ast.rc,o9c/test/typecheck_bad_remote_object.o9,o9c/test/typecheck_bad_listener_object.o9,o9c/test/typecheck_bad_new_near_object.o9,o9c/test/typecheck_bad_new_far_object.o9 mutants=remote_objects gate=ast-test timeout=120
id=O9INV-TABULA-CTOR area=tabula rule="Untyped tabula constructors take one path or two schema arguments." behavior="tabula constructor takes 1 path argument or 2 schema arguments" tests=o9c/test/production_ast.rc,o9c/test/typecheck_bad_tabula_ctor_arity.o9 mutants=tabula_ctor_arity gate=ast-test timeout=120
id=O9INV-TABULA-METHOD-ARITY area=tabula rule="Tabula builtin methods enforce exact arity." behavior="tabula.set takes 2 arguments, got 1" tests=o9c/test/production_ast.rc,o9c/test/typecheck_bad_tab_arity.o9,o9c/test/typecheck_bad_tabula_next_arg.o9 mutants=weaken_msg_rule_arity gate=ast-test timeout=120
id=O9INV-TUPLE-DATA-ONLY area=tuples rule="Tuple payloads are data-only and cannot contain object handles." behavior="tuple field cannot be an object handle" tests=o9c/test/production_ast.rc,o9c/test/typecheck_bad_tuple_object_call.o9 mutants=tuple_object_payload gate=ast-test timeout=120
id=O9INV-RAWC-INTERNALS area=raw-c rule="Raw C blocks cannot access generated self or o9 internals." behavior="raw C function blocks cannot access self or forbidden o9 internal symbol" tests=o9c/test/production_ast.rc,o9c/test/typecheck_bad_rawc_internal_type.o9,o9c/test/typecheck_bad_rawc_find_instance.o9,o9c/test/typecheck_bad_rawc_prefix.o9,o9c/test/typecheck_bad_rawc_exact.o9,o9c/test/function_object_contract/typecheck_bad_function_object_rawc_self.o9 mutants=allow_rawc_internals gate=ast-test timeout=120
id=O9INV-RAWC-OBJECT-BOUNDARY area=raw-c rule="Raw C function bodies cannot take object handles across the o9 boundary." behavior="raw C functions cannot take object handle" tests=o9c/test/production_ast.rc,o9c/test/typecheck_bad_rawc_object_param.o9 mutants=allow_rawc_object_handles gate=ast-test timeout=120
id=O9INV-FUNCTION-TYPE area=function-objects rule="The function placeholder type does not accept type arguments." behavior="function type does not accept angle brackets" tests=o9c/test/run_function_object_contract.rc,o9c/test/function_object_contract/typecheck_bad_function_object_generic_type.o9 mutants=allow_function_type_args gate=function-object-contract-test timeout=180
id=O9INV-FUNCTION-OBJECT-PARAM area=function-objects rule="Function objects cannot take object handles." behavior="function object cannot take object handle" tests=o9c/test/run_function_object_contract.rc,o9c/test/function_object_contract/typecheck_bad_function_object_object_param.o9 mutants=allow_function_object_params gate=function-object-contract-test timeout=180
id=O9INV-IMPORT-PATH area=imports rule="Imports must stay within the importing file directory subtree." behavior="import path escapes the importing file directory" tests=o9c/test/production_ast.rc,o9c/test/impdir/escape.o9,o9c/test/impdir/escape_real.o9 mutants=allow_import_escape gate=ast-test timeout=120
id=O9INV-IMPORT-MAIN area=imports rule="Imported source cannot contribute a runnable main block." behavior="imported main is stripped before parse/codegen" tests=o9c/test/run_e2e.rc,o9c/test/e2e_import_strip_main.o9,o9c/test/e2e_import_strip_main.expected,o9c/test/impdir/lib_with_main.o9 mutants=keep_imported_main gate=run-test:e2e_import_strip_main timeout=180
id=O9INV-MAIN-SINGLE area=main rule="A program has at most one root main block." behavior="only one main block is allowed" tests=o9c/test/production_ast.rc,o9c/test/typecheck_bad_multiple_main.o9 mutants=allow_multiple_main gate=ast-test timeout=120
id=O9INV-SELF-SEND-GUARD area=self-send rule="Synchronous actor sends to the current actor are rejected instead of deadlocking." behavior="try self-send returns the guard failure path" tests=o9c/test/run_e2e.rc,o9c/test/e2e_self_send_guard.o9,o9c/test/e2e_self_send_guard.expected mutants=disable_self_send_guard gate=run-test:e2e_self_send_guard timeout=45
