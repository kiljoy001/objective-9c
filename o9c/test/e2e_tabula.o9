// tabula — the first-class data-envelope type. Create, fill with entries,
// read values, serialize. Backed by libtab; every value is text.
main {
    tabula t = new tabula("orders", "item,qty");
    t.add("a");
    t.set("item", "widget");
    t.set("qty", "5");
    t.add("b");
    t.set("item", "gadget");
    t.set("qty", "3");

    // iterate and read values back
    int64 n = t.first();
    while(n == 1) {
        print(t.get("item"), " ", t.get("qty"), "\n");
        n = t.next();
    }
    t.close();
}
