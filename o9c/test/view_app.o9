interface ViewController {
    internal method FileTree display(string id, string caller);
    internal method string readText(string id, string path);
    internal method int64 writeText(string id, string path, int64 offset, string text, bool truncate);
}

interface ViewModel {
    internal method string title();
}

class ViewData {
    ViewModel;

    internal method string title() {
        return "viewer";
    }
}

function ViewSpliceRaw(string previous, int64 offset, string text) string {
    string next;
    c {
        vlong oldlen = o9_string_len(previous);
        vlong ntext = o9_string_len(text);
        vlong tail = oldlen > offset+ntext ? oldlen-offset-ntext : 0;
        next = o9_string_new(nil, offset+ntext+tail);
        if(next != nil){
            memmove(o9_string_data(next), o9_string_data(previous), offset);
            memmove(o9_string_data(next)+offset, o9_string_data(text), ntext);
            if(tail > 0) memmove(o9_string_data(next)+offset+ntext,
                o9_string_data(previous)+offset+ntext, tail);
        }
    }
    return next;
}

class ViewExample {
    ViewController;
    private ViewModel model;
    private Dict<string,FileTree> trees;
    private Dict<string,string> values;

    method ViewExample(ViewModel source) {
        model = source;
    }

    internal method FileTree display(string id, string caller) {
        FileTree tree = new FileTree();
        tree.dir("nested");
        tree.text("identity", model.title(), false);
        tree.text("nested/caller", caller, false);
        tree.live("live", false);
        tree.live("trigger", true);
        tree.text("editable", "start", true);
        tree.dir("deep");
        tree.dir("deep/d01");
        tree.dir("deep/d01/d02");
        tree.dir("deep/d01/d02/d03");
        tree.dir("deep/d01/d02/d03/d04");
        tree.dir("deep/d01/d02/d03/d04/d05");
        tree.dir("deep/d01/d02/d03/d04/d05/d06");
        tree.dir("deep/d01/d02/d03/d04/d05/d06/d07");
        tree.dir("deep/d01/d02/d03/d04/d05/d06/d07/d08");
        tree.dir("deep/d01/d02/d03/d04/d05/d06/d07/d08/d09");
        tree.dir("deep/d01/d02/d03/d04/d05/d06/d07/d08/d09/d10");
        tree.dir("deep/d01/d02/d03/d04/d05/d06/d07/d08/d09/d10/d11");
        tree.dir("deep/d01/d02/d03/d04/d05/d06/d07/d08/d09/d10/d11/d12");
        tree.dir("deep/d01/d02/d03/d04/d05/d06/d07/d08/d09/d10/d11/d12/d13");
        tree.dir("deep/d01/d02/d03/d04/d05/d06/d07/d08/d09/d10/d11/d12/d13/d14");
        tree.dir("deep/d01/d02/d03/d04/d05/d06/d07/d08/d09/d10/d11/d12/d13/d14/d15");
        tree.dir("deep/d01/d02/d03/d04/d05/d06/d07/d08/d09/d10/d11/d12/d13/d14/d15/d16");
        tree.dir("deep/d01/d02/d03/d04/d05/d06/d07/d08/d09/d10/d11/d12/d13/d14/d15/d16/d17");
        tree.text("deep/d01/d02/d03/d04/d05/d06/d07/d08/d09/d10/d11/d12/d13/d14/d15/d16/d17/leaf", "depth", false);
        trees[id] = tree;
        values[id] = "start";
        return tree;
    }

    internal method string readText(string id, string path) {
        return cat("live:", path);
    }

    internal method int64 writeText(string id, string path, int64 offset, string text, bool truncate) {
        if(!trees.Has(id)) {
            return -1;
        }
        FileTree tree = trees[id];
        if(cmp(path, "trigger") == 0) {
            tree.text("created", text, false);
            return len(text);
        }
        if(cmp(path, "editable") != 0) { return -1; }
        string previous = values[id];
        if(truncate) { previous = ""; }
        if(offset < 0 || offset > len(previous)) { return -1; }
        Task<string> splice = spawn ViewSpliceRaw(previous, offset, text);
        string next = splice.await();
        if(next == nil) { return -1; }
        int64 changed = tree.text("editable", next, true);
        if(changed < 0) { return -1; }
        values[id] = next;
        return len(text);
    }
}

main {
    ViewData source = new ViewData();
    ViewExample controller = new ViewExample(source);
    viewController(controller);
    serve();
}
