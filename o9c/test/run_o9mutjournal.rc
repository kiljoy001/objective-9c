#!/bin/rc

# Focused verification of the Quake-3 event journal and crash recovery:
#   1. a normal worker run emits the full lifecycle to journal.log
#   2. requeue-stale bumps a stale task's attempt, then retires it as
#      infra_fail once attempt exceeds max_attempts (3 in config.tab).

tool=./o9c/o9c
fail=0
tmpbase=/tmp
if(test -d /mnt/term/tmp)
	tmpbase=/mnt/term/tmp
if(! ~ $#O9MUT_TMP 0)
	tmpbase=$O9MUT_TMP
tmp=$tmpbase/o9mutjournal.$pid
src=$tmp/src

fn cleanup {
	rm -rf $tmp >[2]/dev/null
}

fn buildgrid {
	name=$1
	cfile=$tmp/$name.c
	ofile=$tmp/$name.6
	bin=$tmp/$name
	cerr=$tmp/$name.err

	if(! $tool $src/$name.o9 >$cfile){
		echo $name': transpile failed' >[1=2]
		fail=1
	}
	if(~ $fail 0 && ! 6c -FVw -I. -o $ofile $cfile >$cerr >[2=1]){
		echo $name': compile failed' >[1=2]
		cat $cerr >[1=2]
		fail=1
	}
	if(~ $fail 0 && grep -s 'warning:' $cerr){
		echo $name': 6c warning treated as error' >[1=2]
		cat $cerr >[1=2]
		fail=1
	}
	if(~ $fail 0 && ! 6l -o $bin $ofile libo9.a /$objtype/lib/libndb.a){
		echo $name': link failed' >[1=2]
		fail=1
	}
}

if(! test -e $tool){
	echo missing $tool >[1=2]
	exit missing
}
if(! test -e libo9.a){
	echo missing libo9.a >[1=2]
	exit missing
}

cleanup
mkdir $tmp
mkdir $src
mkdir $src/stdlib
cp grid/*.o9 $src
stdsrc=stdlib
if(! test -e $stdsrc/process.o9)
	stdsrc=/sys/lib/o9/stdlib
if(! test -e $stdsrc/process.o9)
	stdsrc=$home/lib/o9/stdlib
if(! test -e $stdsrc/process.o9){
	echo 'o9mutjournal: missing stdlib/process.o9' >[1=2]
	cleanup
	exit missing
}
cp $stdsrc/*.o9 $src/stdlib

for(name in o9mutctl o9mutw)
	buildgrid $name

if(! ~ $fail 0){
	cleanup
	exit fail
}

root=$tmp/root
journal=$root/journal.log

# --- phase 1: a normal run emits the full event sequence ---
$tmp/o9mutctl -r $root init >[2]/dev/null
$tmp/o9mutctl -r $root enqueue jpass sample sample 'echo pass' 5000 100 >[2]/dev/null
$tmp/o9mutw -r $root -w jw -n 1 >[2]/dev/null

if(! test -e $journal){
	echo 'o9mutjournal: journal.log not created' >[1=2]
	fail=1
}
if(~ $fail 0){
	for(ev in enqueue worker_start task_claim gate_start gate_exit task_done worker_stop)
		if(! grep -s $ev $journal){
			echo 'o9mutjournal: missing event '^$ev >[1=2]
			fail=1
		}
}

# --- phase 2: crash recovery — attempt bump, then retire at max_attempts ---
# Fabricate a task whose worker died mid-run: a pending file with attempt=2
# and a stale claim dir.  config.tab sets max_attempts=3.
tid=crashtest
pend=$root/tasks/pending/^$tid^.tab
claimdir=$root/tasks/claimed/^$tid
res=$root/results/^$tid^.tab

mkdir $claimdir
echo 'task_id	source	mutant_path	gate	timeout_ms	priority	attempt	created_at' > $pend
echo 'crashtest	sample	sample	echo pass	5000	100	2	1234567890' >> $pend
echo 'task_id	worker_id	claimed_at' > $claimdir/claim.tab
echo 'crashtest	dead	1234567890' >> $claimdir/claim.tab

sleep 2
$tmp/o9mutctl -r $root requeue-stale 1 >$tmp/rq1.out >[2]/dev/null
if(! grep -s 'requeued_tasks	1' $tmp/rq1.out){
	echo 'o9mutjournal: requeue did not report requeued_tasks=1' >[1=2]
	cat $tmp/rq1.out >[1=2]
	fail=1
}
if(! grep -s '	3	' $pend){
	echo 'o9mutjournal: attempt not bumped to 3' >[1=2]
	fail=1
}

# second pass: attempt 3 -> 4 > max_attempts(3) -> retire as infra_fail
mkdir $claimdir
echo 'task_id	worker_id	claimed_at' > $claimdir/claim.tab
echo 'crashtest	dead	1234567891' >> $claimdir/claim.tab
sleep 2
$tmp/o9mutctl -r $root requeue-stale 1 >$tmp/rq2.out >[2]/dev/null
if(! grep -s 'retired	1' $tmp/rq2.out){
	echo 'o9mutjournal: retire did not report retired=1' >[1=2]
	cat $tmp/rq2.out >[1=2]
	fail=1
}
if(! grep -s infra_fail $res){
	echo 'o9mutjournal: retired task has no infra_fail result' >[1=2]
	fail=1
}
if(test -e $pend){
	echo 'o9mutjournal: retired task pending file not removed' >[1=2]
	fail=1
}

if(~ $fail 0)
	echo o9mutjournal: OK

cleanup
if(! ~ $fail 0)
	exit fail
exit ''
