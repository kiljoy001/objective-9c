#!/bin/rc

rfork e

repo=`{pwd}
nodes=(dev9p authomatic babyFileServer.rentonsoftworks.coin)
workers=3
jobs=0
root=''
enqueue=''
fail=0
authcheck=1
confirm=1

fn usage {
	echo 'usage: grid/run_3node_campaign.rc [-A] [-y] [-r root] [-n workers-per-node] [-j jobs-per-worker] [-E enqueue.rc] [node ...]' >[1=2]
	echo '  -j 0 means persistent workers; drain them with o9mutctl drain-worker' >[1=2]
	echo '  -A skips rcpu auth probes; -y skips the interactive login confirmation' >[1=2]
	exit usage
}

while(! ~ $#* 0){
	switch($1){
	case -r
		if(~ $#* 1) usage
		root=$2
		shift
	case -n
		if(~ $#* 1) usage
		workers=$2
		shift
	case -j
		if(~ $#* 1) usage
		jobs=$2
		shift
	case -E
		if(~ $#* 1) usage
		enqueue=$2
		shift
	case -A
		authcheck=0
	case -y
		confirm=0
	case -h --help
		usage
	case *
		nodes=$*
		*=''
	}
	shift
}

if(~ $root '')
	root=/n/babyFileServer.rentonsoftworks.coin/tmp/o9mut-campaign.$pid

tmpbase=/tmp
if(test -d /mnt/term/tmp)
	tmpbase=/mnt/term/tmp
if(! ~ $#O9MUT_TMP 0)
	tmpbase=$O9MUT_TMP
try=$tmpbase/o9mutcampaign.launch.$pid
src=$try/src

fn buildtool {
	name=$1
	echo build $name
	if(! ./o9c/o9c $src/$name.o9 >$try/$name.c){
		echo $name': transpile failed' >[1=2]
		fail=1
	}
	if(~ $fail 0 && ! 6c -FVw -I. -o $try/$name.6 $try/$name.c >$try/$name.err >[2=1]){
		echo $name': compile failed' >[1=2]
		cat $try/$name.err >[1=2]
		fail=1
	}
	if(~ $fail 0 && grep -s 'warning:' $try/$name.err){
		echo $name': warning treated as error' >[1=2]
		cat $try/$name.err >[1=2]
		fail=1
	}
	if(~ $fail 0 && ! 6l -o $try/$name $try/$name.6 libo9.a /$objtype/lib/libndb.a){
		echo $name': link failed' >[1=2]
		fail=1
	}
}

echo repo $repo
echo root $root
echo nodes $nodes
echo workers_per_node $workers
echo jobs_per_worker $jobs
if(! ~ $enqueue '')
	echo enqueue_script $enqueue

if(~ $confirm 1){
	echo ''
	echo 'preflight: each target node must already accept rcpu without prompting.'
	echo 'run these manually first if you have not already logged in:'
	for(node in $nodes)
		echo '  rcpu -h '$node' -c ''echo ok'''
	echo ''
	echo 'type y and press Enter to continue launching after node login preflight: [y/n]'
	answer=`{read}
	if(! ~ $answer y Y yes YES){
		echo 'aborted: log into the nodes, then rerun this command' >[1=2]
		exit preflight
	}
}

mkdir $try
mkdir $src
mkdir $src/stdlib
cp grid/*.o9 $src

stdsrc=stdlib
if(! test -e $stdsrc/process.o9)
	stdsrc=/sys/lib/o9/stdlib
if(! test -e $stdsrc/process.o9)
	stdsrc=$home/lib/o9/stdlib
if(! test -e $stdsrc/process.o9){
	echo 'missing stdlib/process.o9' >[1=2]
	exit missing
}
cp $stdsrc/*.o9 $src/stdlib

for(name in o9mutctl o9mutq o9mutw)
	buildtool $name

if(! ~ $fail 0)
	exit build

echo init
if(! $try/o9mutctl -r $root init)
	exit init

bindir=$root/bin
mkdir $bindir >[2]/dev/null
cp $try/o9mutctl $try/o9mutq $try/o9mutw $bindir

if(! ~ $enqueue ''){
	echo enqueue
	if(! rc $enqueue $root){
		echo 'enqueue failed: '^$enqueue >[1=2]
		exit enqueue
	}
	echo enqueue_complete
}

if(~ $authcheck 1){
	echo auth-check
	for(node in $nodes){
		authlog=$root/logs/auth.$node.out
		echo rcpu-auth $node
		if(! rcpu -h $node -c 'echo o9mut-auth-ok' >$authlog >[2=1]){
			echo 'auth check failed for '^$node >[1=2]
			cat $authlog >[1=2]
			fail=1
		}
	}
	if(! ~ $fail 0)
		exit auth
}

echo launch
remoteroot=/mnt/term^$root
remotebindir=/mnt/term^$bindir
echo launch-queue
for(node in $nodes){
	qworker=$node^'-queue'
	echo rcpu-queue $node $qworker
	rcpu -h $node -c $remotebindir/o9mutq' -r '$remoteroot' -w '$qworker' -idle-ms 1000 -max-pending 512' </dev/null >$root/logs/launchq.$node.out >[2=1] &
}
echo launch-workers
for(node in $nodes){
	for(w in `{seq 1 $workers}){
		worker=$node^-$w
		echo rcpu $node $worker
		rcpu -h $node -c $remotebindir/o9mutw' -r '$remoteroot' -w '$worker' -n '$jobs' -idle-ms 5000' </dev/null >$root/logs/launch.$worker.out >[2=1] &
	}
}

echo launched
echo 'monitor with:'
echo '  '$bindir'/o9mutctl -r '$root' status'
echo '  '$bindir'/o9mutctl -r '$root' report'
echo '  ls '$root'/results | wc -l'
echo 'drain with:'
for(node in $nodes)
	for(w in `{seq 1 $workers})
		echo '  '$bindir'/o9mutctl -r '$root' drain-worker '$node^-$w
