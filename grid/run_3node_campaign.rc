#!/bin/rc

rfork e

repo=`{pwd}
nodes=(dev9p.rentonsoftworks.coin Authomatic.rentonsoftworks.coin babyFileServer.rentonsoftworks.coin)
workers=3
jobs=0
root=''
enqueue=''
fail=0
authcheck=1
confirm=1
daemon=0
waitdrain=0
drain_timeout=3600
launchmode=rcpu
agentprefix=''
agentcmdnodes=()
agentcmdids=()

fn usage {
	echo 'usage: grid/run_3node_campaign.rc [-A] [-y] [-W] [-D] [-L rcpu|agent] [-M agent-path-prefix] [-r root]' >[1=2]
	echo '  [-n workers-per-node] [-j jobs-per-worker] [-T drain-timeout-sec] [-E enqueue.rc] [node ...]' >[1=2]
	echo '  -j 0 means persistent workers; drain them with o9mutctl drain-worker' >[1=2]
	echo '  -A skips rcpu auth probes; -y skips the interactive login confirmation' >[1=2]
	echo '  -D launches one o9mutd recovery daemon (cycles=0) on the first node' >[1=2]
	echo '  -W blocks until the grid drains after launching; -T sets the drain timeout (default 3600s)' >[1=2]
	echo '  -L agent queues tabula launch commands for resident o9mutagent.rc processes' >[1=2]
	echo '  -M prefixes paths inside agent commands, e.g. /mnt/term for rcpu-bootstrapped agents' >[1=2]
	exit usage
}

while(! ~ $#* 0){
	switch($1){
	case -r
		if(~ $#* 1) usage
		root=$2
		shift
	case -n
		if(~ $#* 1) usage
		workers=$2
		shift
	case -j
		if(~ $#* 1) usage
		jobs=$2
		shift
	case -E
		if(~ $#* 1) usage
		enqueue=$2
		shift
	case -T
		if(~ $#* 1) usage
		drain_timeout=$2
		shift
	case -L
		if(~ $#* 1) usage
		launchmode=$2
		shift
	case -M
		if(~ $#* 1) usage
		agentprefix=$2
		shift
	case -A
		authcheck=0
	case -y
		confirm=0
	case -D
		daemon=1
	case -W
		waitdrain=1
	case -h --help
		usage
	case *
		nodes=$*
		*=''
	}
	shift
}

if(~ $root '')
	root=/n/babyFileServer.rentonsoftworks.coin/tmp/o9mut-campaign.$pid

tmpbase=/tmp
if(test -d /mnt/term/tmp)
	tmpbase=/mnt/term/tmp
if(! ~ $#O9MUT_TMP 0)
	tmpbase=$O9MUT_TMP
try=$tmpbase/o9mutcampaign.launch.$pid
src=$try/src

fn buildtool {
	name=$1
	echo build $name
	if(! ./o9c/o9c $src/$name.o9 >$try/$name.c){
		echo $name': transpile failed' >[1=2]
		fail=1
	}
	if(~ $fail 0 && ! 6c -FVw -I. -o $try/$name.6 $try/$name.c >$try/$name.err >[2=1]){
		echo $name': compile failed' >[1=2]
		cat $try/$name.err >[1=2]
		fail=1
	}
	if(~ $fail 0 && grep -s 'warning:' $try/$name.err){
		echo $name': warning treated as error' >[1=2]
		cat $try/$name.err >[1=2]
		fail=1
	}
	if(~ $fail 0 && ! 6l -o $try/$name $try/$name.6 libo9.a /$objtype/lib/libndb.a){
		echo $name': link failed' >[1=2]
		fail=1
	}
}

echo repo $repo
echo root $root
echo nodes $nodes
echo workers_per_node $workers
echo jobs_per_worker $jobs
echo launch_mode $launchmode
if(! ~ $agentprefix '')
	echo agent_path_prefix $agentprefix
if(! ~ $enqueue '')
	echo enqueue_script $enqueue
if(~ $daemon 1)
	echo daemon yes
if(~ $waitdrain 1)
	echo wait_drain yes timeout $drain_timeout

if(! ~ $launchmode rcpu agent)
	usage
if(~ $launchmode agent)
	authcheck=0

if(~ $confirm 1){
	echo ''
	if(~ $launchmode rcpu){
		echo 'preflight: each target node must already accept rcpu without prompting.'
		echo 'run these manually first if you have not already logged in:'
		for(node in $nodes)
			echo '  rcpu -h '$node' -c ''echo ok'''
	}
	if(~ $launchmode agent){
		echo 'preflight: one o9mutagent.rc process must already be running on each target node.'
		echo 'agent commands will be queued as inert .tab files; this run will not call rcpu.'
	}
	echo ''
	echo 'type y and press Enter to continue launching after node login preflight: [y/n]'
	answer=`{read}
	if(! ~ $answer y Y yes YES){
		echo 'aborted: log into the nodes, then rerun this command' >[1=2]
		exit preflight
	}
}

mkdir $try
mkdir $src
mkdir $src/stdlib
cp grid/*.o9 $src

stdsrc=stdlib
if(! test -e $stdsrc/process.o9)
	stdsrc=/sys/lib/o9/stdlib
if(! test -e $stdsrc/process.o9)
	stdsrc=$home/lib/o9/stdlib
if(! test -e $stdsrc/process.o9){
	echo 'missing stdlib/process.o9' >[1=2]
	exit missing
}
cp $stdsrc/*.o9 $src/stdlib

buildlist=(o9mutctl o9mutq o9mutw)
if(~ $daemon 1)
	buildlist=($buildlist o9mutd)
for(name in $buildlist)
	buildtool $name

if(! ~ $fail 0)
	exit build

echo init
if(! $try/o9mutctl -r $root init)
	exit init

bindir=$root/bin
mkdir $bindir >[2]/dev/null
binpaths=()
for(name in $buildlist)
	binpaths=($binpaths $try/$name)
cp $binpaths $bindir
if(~ $launchmode agent)
	cp grid/o9mutagent.rc $bindir

if(! ~ $enqueue ''){
	echo enqueue
	if(! rc $enqueue $root){
		echo 'enqueue failed: '^$enqueue >[1=2]
		exit enqueue
	}
	echo enqueue_complete
}

if(~ $authcheck 1){
	echo auth-check
	for(node in $nodes){
		authlog=$root/logs/auth.$node.out
		echo rcpu-auth $node
		if(! rcpu -h $node -c 'echo o9mut-auth-ok' >$authlog >[2=1]){
			echo 'auth check failed for '^$node >[1=2]
			cat $authlog >[1=2]
			fail=1
		}
	}
	if(! ~ $fail 0)
		exit auth
}

echo launch
remoteroot=/mnt/term^$root
remotebindir=/mnt/term^$bindir
# Node-visible repo path: the gate (o9um_gate.rc) copies the repo out of the
# launch host's tree, which every node sees under /mnt/term. Exporting it
# explicitly frees the gate from its hardcoded /mnt/term/mnt/term/home/scott
# fallback. The worker's gate child inherits this via rfork+execl.
remoterepo=/mnt/term^$repo
agentroot=$root
agentbindir=$bindir
agentrepo=$repo
if(! ~ $agentprefix ''){
	agentroot=$agentprefix^$root
	agentbindir=$agentprefix^$bindir
	agentrepo=$agentprefix^$repo
}

fn agent_dirs {
	node=$1
	mkdir $root/agents >[2]/dev/null
	mkdir $root/agents/$node >[2]/dev/null
	mkdir $root/agents/$node/pending >[2]/dev/null
	mkdir $root/agents/$node/claimed >[2]/dev/null
	mkdir $root/agents/$node/done >[2]/dev/null
	mkdir $root/agents/$node/failed >[2]/dev/null
}

fn agent_common {
	node=$1
	id=$2
	op=$3
	worker=$4
	jobsv=$5
	idlev=$6
	maxpendingv=$7
	intervalv=$8
	stalev=$9
	agent_dirs $node
	cmdpath=$root/agents/$node/pending/$id.tab
	echo 'op	root	bindir	repo	worker	jobs	idle_ms	max_pending	interval_ms	stale_sec	cycles	log' >$cmdpath
	echo $op'	'$agentroot'	'$agentbindir'	'$agentrepo'	'$worker'	'$jobsv'	'$idlev'	'$maxpendingv'	'$intervalv'	'$stalev'	'$cyclesv'	'$log >>$cmdpath
	agentcmdnodes=($agentcmdnodes $node)
	agentcmdids=($agentcmdids $id)
}

fn agent_worker_cmd {
	node=$1
	worker=$2
	id=$worker^'.'^$pid
	log=$agentroot/logs/launch.$worker.out
	cyclesv=-
	agent_common $node $id start-worker $worker $jobs 5000 - - -
}

fn agent_queue_cmd {
	node=$1
	worker=$2
	id=$worker^'.'^$pid
	log=$agentroot/logs/launchq.$node.out
	cyclesv=-
	agent_common $node $id start-queue $worker - 1000 512 - -
}

fn agent_daemon_cmd {
	node=$1
	id=daemon.$pid
	log=$agentroot/logs/daemon.out
	cyclesv=0
	agent_common $node $id start-daemon daemon - - - 30000 300
}

if(~ $daemon 1){
	daemonnode=$nodes(1)
	echo launch-daemon $daemonnode
	if(~ $launchmode rcpu)
		rcpu -h $daemonnode -c 'O9MUT_PLAN9_REPO='$remoterepo' '$remotebindir/o9mutd' -r '$remoteroot' -cycles 0 -interval-ms 30000 -stale-sec 300' </dev/null >$root/logs/daemon.out >[2=1] &
	if(~ $launchmode agent)
		agent_daemon_cmd $daemonnode
}
if(! ~ $daemon 1){
	echo 'no daemon: run o9mutctl requeue-stale manually, or relaunch with -D'
}

echo launch-queue
for(node in $nodes){
	qworker=$node^'-queue'
	if(~ $launchmode rcpu){
		echo rcpu-queue $node $qworker
		rcpu -h $node -c $remotebindir/o9mutq' -r '$remoteroot' -w '$qworker' -idle-ms 1000 -max-pending 512' </dev/null >$root/logs/launchq.$node.out >[2=1] &
	}
	if(~ $launchmode agent){
		echo agent-queue $node $qworker
		agent_queue_cmd $node $qworker
	}
}
echo launch-workers
for(node in $nodes){
	for(w in `{seq 1 $workers}){
		worker=$node^-$w
		if(~ $launchmode rcpu){
			echo rcpu $node $worker
			rcpu -h $node -c 'O9MUT_PLAN9_REPO='$remoterepo' '$remotebindir/o9mutw' -r '$remoteroot' -w '$worker' -n '$jobs' -idle-ms 5000' </dev/null >$root/logs/launch.$worker.out >[2=1] &
		}
		if(~ $launchmode agent){
			echo agent $node $worker
			agent_worker_cmd $node $worker
		}
	}
}

echo launched
if(~ $launchmode agent){
	echo 'agent launch mode: start one agent per node if it is not already running:'
	for(node in $nodes)
		echo '  '$agentbindir'/o9mutagent.rc -r '$agentroot' -n '$node
	echo 'agent command status:'
	echo '  ls '$root'/agents/*/done'
	echo '  ls '$root'/agents/*/failed'
}
echo 'monitor with:'
echo '  '$bindir'/o9mutctl -r '$root' status'
echo '  '$bindir'/o9mutctl -r '$root' report'
echo '  ls '$root'/results | wc -l'
echo 'drain with:'
for(node in $nodes)
	for(w in `{seq 1 $workers})
		echo '  '$bindir'/o9mutctl -r '$root' drain-worker '$node^-$w
if(~ $daemon 1)
	echo '  kill the daemon on '$nodes(1)' (root/logs/daemon.out) when done'

if(~ $waitdrain 1){
	if(~ $launchmode agent){
		echo wait-agent-commands
		agentaccepted=0
		for(i in `{seq 1 60}){
			if(~ $agentaccepted 0){
				pendingagent=()
				failedagent=()
				for(ci in `{seq 1 $#agentcmdids}){
					cnode=$agentcmdnodes($ci)
					cid=$agentcmdids($ci)
					if(test -e $root/agents/$cnode/failed/$cid.tab)
						failedagent=($failedagent $cnode/$cid)
					if(! test -e $root/agents/$cnode/done/$cid.tab && ! test -e $root/agents/$cnode/failed/$cid.tab)
						pendingagent=($pendingagent $cnode/$cid)
				}
				if(! ~ $#failedagent 0){
					echo 'agent command failed:' $failedagent >[1=2]
					exit agent-failed
				}
				if(~ $#pendingagent 0)
					agentaccepted=1
				if(~ $agentaccepted 0)
					sleep 1
			}
		}
		if(~ $agentaccepted 0){
			echo 'agent command timeout:' $pendingagent >[1=2]
			exit agent-timeout
		}
		echo agent-commands-accepted
	}
	echo wait-drain
	$bindir/o9mutctl -r $root wait-drain $drain_timeout >$root/logs/wait-drain.out >[2=1]
	if(grep -s '^timeout' $root/logs/wait-drain.out){
		echo 'drain timed out:' >[1=2]
		cat $root/logs/wait-drain.out >[1=2]
		exit drain
	}
	echo drain-complete
	cat $root/logs/wait-drain.out
	if(~ $jobs 0){
		echo drain-persistent-workers
		for(node in $nodes){
			for(w in `{seq 1 $workers}){
				worker=$node^-$w
				$bindir/o9mutctl -r $root drain-worker $worker >>$root/logs/drain-workers.out >[2=1]
			}
		}
		workersstopped=0
		for(i in `{seq 1 60}){
			if(~ $workersstopped 0){
				pendingstops=()
				for(node in $nodes){
					for(w in `{seq 1 $workers}){
						worker=$node^-$w
						wtab=$root/workers/$worker.tab
						if(! test -e $wtab)
							pendingstops=($pendingstops $worker)
						if(test -e $wtab && ! grep -s '	stopped	' $wtab)
							pendingstops=($pendingstops $worker)
					}
				}
				if(~ $#pendingstops 0)
					workersstopped=1
				if(~ $workersstopped 0)
					sleep 1
			}
		}
		if(~ $workersstopped 0){
			echo 'worker drain timed out:' $pendingstops >[1=2]
			exit worker-drain
		}
		echo workers-drained
	}
}
