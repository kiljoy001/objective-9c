import "o9mutlib.o9";
import "stdlib/process.o9";
import "stdlib/time.o9";

main {
    Process p = new Process();
    Time tm = new Time();
    O9Mut grid = new O9Mut();
    string root = grid.defaultRoot();
    string cmd;
    string priority;
    int64 nargs = p.argc();

    if(nargs < 2) {
        print("usage: o9mutctl [-r root] init|status|report|requeue-stale|drain-worker|manifest|enqueue|wait-drain|triage ...\n");
    } else {
        int64 idx = 1;
        if(nargs > 3 && cmp(p.arg(1), "-r") == 0) {
            root = p.arg(2);
            idx = 3;
        }
        cmd = p.arg(idx);
        if(cmp(cmd, "init") == 0) {
            if(grid.init(root)) {
                print("initialized\t", root, "\n");
            } else {
                print("init failed\t", root, "\n");
            }
        } else if(cmp(cmd, "status") == 0) {
            int64 bySource = 0;
            int64 workers = 0;
            int64 fromJournal = 0;
            int64 si = idx + 1;
            while(si < nargs) {
                if(cmp(p.arg(si), "--by-source") == 0) {
                    bySource = 1;
                } else if(cmp(p.arg(si), "--workers") == 0) {
                    workers = 1;
                } else if(cmp(p.arg(si), "--from-journal") == 0) {
                    fromJournal = 1;
                }
                si = si + 1;
            }
            print(grid.statusEx(root, bySource, workers, fromJournal));
        } else if(cmp(cmd, "report") == 0) {
            print(grid.report(root));
        } else if(cmp(cmd, "requeue-stale") == 0) {
            int64 stale = 300;
            if(nargs > idx + 1) {
                stale = tm.parse(p.arg(idx + 1));
            }
            print(grid.requeueStale(root, stale));
        } else if(cmp(cmd, "drain-worker") == 0) {
            if(nargs <= idx + 1) {
                print("usage: o9mutctl [-r root] drain-worker worker-id\n");
            } else {
                print(grid.drainWorker(root, p.arg(idx + 1)));
            }
        } else if(cmp(cmd, "manifest") == 0) {
            if(nargs <= idx + 1) {
                print("usage: o9mutctl [-r root] manifest manifest.tsv\n");
            } else {
                print(grid.enqueueManifest(root, p.arg(idx + 1)));
            }
        } else if(cmp(cmd, "enqueue") == 0) {
            if(nargs <= idx + 5) {
                print("usage: o9mutctl [-r root] enqueue task-id source mutant-path gate timeout-ms [priority]\n");
            } else {
                priority = "100";
                if(nargs > idx + 6) {
                    priority = p.arg(idx + 6);
                }
                print(grid.enqueue(root, p.arg(idx + 1), p.arg(idx + 2), p.arg(idx + 3), p.arg(idx + 4), p.arg(idx + 5), priority));
            }
        } else if(cmp(cmd, "wait-drain") == 0) {
            int64 timeoutSec = 0;
            int64 intervalMs = 1000;
            int64 wi = idx + 1;
            int64 positional = 0;
            while(wi < nargs) {
                if(cmp(p.arg(wi), "--timeout") == 0 && wi + 1 < nargs) {
                    timeoutSec = tm.parse(p.arg(wi + 1));
                    wi = wi + 2;
                } else if(cmp(p.arg(wi), "--poll-ms") == 0 && wi + 1 < nargs) {
                    intervalMs = tm.parse(p.arg(wi + 1));
                    wi = wi + 2;
                } else {
                    if(positional == 0) {
                        timeoutSec = tm.parse(p.arg(wi));
                    } else if(positional == 1) {
                        intervalMs = tm.parse(p.arg(wi));
                    }
                    positional = positional + 1;
                    wi = wi + 1;
                }
            }
            string waitResult = grid.waitDrain(root, timeoutSec * 1000, intervalMs);
            print(waitResult);
            if(cmp(waitResult, "drained\n") != 0) {
                fail("drain timed out");
            }
        } else if(cmp(cmd, "triage") == 0) {
            string output = "";
            string repo = "";
            string equivFile = "";
            int64 fromJournal = 0;
            int64 classifyEquivalent = 0;
            int64 classifyWhitespace = 0;
            int64 includeMissing = 0;
            int64 bad = 0;
            int64 ti = idx + 1;
            while(ti < nargs) {
                if(cmp(p.arg(ti), "--output") == 0 && ti + 1 < nargs) {
                    output = p.arg(ti + 1);
                    ti = ti + 2;
                } else if(cmp(p.arg(ti), "--from-journal") == 0) {
                    fromJournal = 1;
                    ti = ti + 1;
                } else if(cmp(p.arg(ti), "--repo") == 0 && ti + 1 < nargs) {
                    repo = p.arg(ti + 1);
                    ti = ti + 2;
                } else if(cmp(p.arg(ti), "--equiv-file") == 0 && ti + 1 < nargs) {
                    equivFile = p.arg(ti + 1);
                    ti = ti + 2;
                } else if(cmp(p.arg(ti), "--classify-equivalent") == 0) {
                    classifyEquivalent = 1;
                    ti = ti + 1;
                } else if(cmp(p.arg(ti), "--classify-whitespace-equivalent") == 0) {
                    classifyWhitespace = 1;
                    ti = ti + 1;
                } else if(cmp(p.arg(ti), "--include-missing") == 0) {
                    includeMissing = 1;
                    ti = ti + 1;
                } else {
                    print("usage: o9mutctl [-r root] triage [--output file] [--from-journal] [--repo path] [--equiv-file file] [--classify-equivalent] [--classify-whitespace-equivalent] [--include-missing]\n");
                    bad = 1;
                    ti = nargs;
                }
            }
            if(bad == 1) {
                fail("usage");
            } else {
                print(grid.triage(root, output, fromJournal, repo, classifyEquivalent, classifyWhitespace, includeMissing, equivFile));
            }
        } else {
            print("unknown command ", cmd, "\n");
            print("usage: o9mutctl [-r root] init|status|report|requeue-stale|drain-worker|manifest|enqueue|wait-drain|triage ...\n");
            fail("usage");
        }
    }
}
