#!/bin/rc

rfork e

repo=`{pwd}
nodes=(dev9p.rentonsoftworks.coin Authomatic.rentonsoftworks.coin babyFileServer.rentonsoftworks.coin)
workers=3
jobs=0
queuemax=512
root=''
manifest=o9c/test/artifacts/o9um_grid_manifest.tsv
localbase=/tmp
fail=0
waitprepare=1

fn usage {
	echo 'usage: grid/run_decentralized_campaign.rc [-r controller-root] [-m manifest.tsv]' >[1=2]
	echo '  [-n workers-per-node] [-j jobs-per-worker] [-Q queue-max-pending] [-B node-local-base] [node ...]' >[1=2]
	echo '  Queues prepare-shard plus node-local start-queue/start-worker commands for resident agents.' >[1=2]
	exit usage
}

while(! ~ $#* 0){
	switch($1){
	case -r
		if(~ $#* 1) usage
		root=$2
		shift
	case -m
		if(~ $#* 1) usage
		manifest=$2
		shift
	case -n
		if(~ $#* 1) usage
		workers=$2
		shift
	case -j
		if(~ $#* 1) usage
		jobs=$2
		shift
	case -Q
		if(~ $#* 1) usage
		queuemax=$2
		shift
	case -B
		if(~ $#* 1) usage
		localbase=$2
		shift
	case -h --help
		usage
	case *
		nodes=$*
		*=''
	}
	shift
}

if(~ $root '')
	root=/n/babyFileServer.rentonsoftworks.coin/tmp/o9mut-decentralized.$pid

tmpbase=/tmp
if(test -d /mnt/term/tmp)
	tmpbase=/mnt/term/tmp
if(! ~ $#O9MUT_TMP 0)
	tmpbase=$O9MUT_TMP
try=$tmpbase/o9mutdecentralized.launch.$pid
src=$try/src
sharddir=$root/controller/shards
collectroot=$root/controller

fn buildtool {
	name=$1
	echo build $name
	if(! ./o9c/o9c $src/$name.o9 >$try/$name.c){
		echo $name': transpile failed' >[1=2]
		fail=1
	}
	if(~ $fail 0 && ! 6c -FVw -I. -o $try/$name.6 $try/$name.c >$try/$name.err >[2=1]){
		echo $name': compile failed' >[1=2]
		cat $try/$name.err >[1=2]
		fail=1
	}
	if(~ $fail 0 && grep -s 'warning:' $try/$name.err){
		echo $name': warning treated as error' >[1=2]
		cat $try/$name.err >[1=2]
		fail=1
	}
	if(~ $fail 0 && ! 6l -o $try/$name $try/$name.6 libo9.a /$objtype/lib/libndb.a){
		echo $name': link failed' >[1=2]
		fail=1
	}
}

fn snapshot_repo {
	snap=$1
	echo snapshot-repo $snap
	rm -rf $snap >[2]/dev/null
	mkdir $snap || exit snapshot
	mkdir $snap/o9c || exit snapshot
	for(f in $repo/o9c/*){
		name=`{basename $f}
		if(! ~ $name test grammar.d){
			if(! test -d $f)
				cp $f $snap/o9c/$name || exit snapshot
		}
	}
	mkdir $snap/o9c/grammar.d || exit snapshot
	dircp $repo/o9c/grammar.d $snap/o9c/grammar.d || exit snapshot
	mkdir $snap/o9c/test || exit snapshot
	for(f in $repo/o9c/test/*){
		name=`{basename $f}
		if(! ~ $name artifacts){
			if(test -d $f){
				mkdir $snap/o9c/test/$name || exit snapshot
				dircp $f $snap/o9c/test/$name || exit snapshot
			}
			if(! test -d $f)
				cp $f $snap/o9c/test/$name || exit snapshot
		}
	}
	mkdir $snap/o9c/test/artifacts >[2]/dev/null
	if(test -e $repo/o9c/test/artifacts/.gitignore)
		cp $repo/o9c/test/artifacts/.gitignore $snap/o9c/test/artifacts/.gitignore >[2]/dev/null
	for(d in libtab stdlib){
		mkdir $snap/$d || exit snapshot
		dircp $repo/$d $snap/$d || exit snapshot
	}
	for(f in mkfile o9.h o9_runtime.c o9_crypto.c o9_tab_discard.c o9_dispatch_$objtype.s monocypher.c monocypher.h)
		cp $repo/$f $snap/$f || exit snapshot
	echo snapshot-repo-complete
}

fn agent_dirs {
	node=$1
	mkdir $root/agents >[2]/dev/null
	mkdir $root/agents/$node >[2]/dev/null
	mkdir $root/agents/$node/pending >[2]/dev/null
	mkdir $root/agents/$node/claimed >[2]/dev/null
	mkdir $root/agents/$node/done >[2]/dev/null
	mkdir $root/agents/$node/failed >[2]/dev/null
}

fn agent_cmd {
	args=($*)
	node=$args(1)
	id=$args(2)
	op=$args(3)
	cmdroot=$args(4)
	bindir=$args(5)
	repopath=$args(6)
	worker=$args(7)
	jobsv=$args(8)
	idlev=$args(9)
	maxpendingv=$args(10)
	intervalv=$args(11)
	stalev=$args(12)
	cyclesv=$args(13)
	log=$args(14)
	shardid=$args(15)
	manifestpath=$args(16)
	localroot=$args(17)
	agent_dirs $node
	cmdpath=$root/agents/$node/pending/$id.tab
	echo 'op	root	bindir	repo	worker	jobs	idle_ms	max_pending	interval_ms	stale_sec	cycles	log	shard_id	manifest	local_root	collect_root' >$cmdpath
	echo $op'	'$cmdroot'	'$bindir'	'$repopath'	'$worker'	'$jobsv'	'$idlev'	'$maxpendingv'	'$intervalv'	'$stalev'	'$cyclesv'	'$log'	'$shardid'	'$manifestpath'	'$localroot'	'$collectroot >>$cmdpath
}

fn wait_agent_ids {
	label=$1
	ids=$2
	ok=0
	for(i in `{seq 1 120}){
		if(~ $ok 0){
			pending=()
			failed=()
			for(pair in $ids){
				node=`{echo $pair | sed 's!/.*!!'}
				id=`{echo $pair | sed 's!.*/!!'}
				if(test -e $root/agents/$node/failed/$id.tab)
					failed=($failed $pair)
				if(! test -e $root/agents/$node/done/$id.tab && ! test -e $root/agents/$node/failed/$id.tab)
					pending=($pending $pair)
			}
			if(! ~ $#failed 0){
				echo $label' failed:' $failed >[1=2]
				exit agent
			}
			if(~ $#pending 0)
				ok=1
			if(~ $ok 0)
				sleep 1
		}
	}
	if(~ $ok 0){
		echo $label' timeout:' $pending >[1=2]
		exit agent
	}
}

echo repo $repo
echo root $root
echo nodes $nodes
echo workers_per_node $workers
echo jobs_per_worker $jobs
echo queue_max_pending $queuemax
echo manifest $manifest
echo node_local_base $localbase

mkdir $try
mkdir $src
mkdir $src/stdlib
cp grid/*.o9 $src

stdsrc=stdlib
if(! test -e $stdsrc/process.o9)
	stdsrc=/sys/lib/o9/stdlib
if(! test -e $stdsrc/process.o9)
	stdsrc=$home/lib/o9/stdlib
if(! test -e $stdsrc/process.o9){
	echo 'missing stdlib/process.o9' >[1=2]
	exit missing
}
cp $stdsrc/*.o9 $src/stdlib

for(name in o9mutctl o9mutq o9mutw o9mutd)
	buildtool $name
if(! ~ $fail 0)
	exit build

mkdir $root
mkdir $root/bin
mkdir $root/logs
mkdir $root/controller
mkdir $sharddir
mkdir $root/controller/results
mkdir $root/controller/journals
mkdir $root/controller/progress
cp $try/o9mutctl $try/o9mutq $try/o9mutw $try/o9mutd $root/bin
cp grid/o9mutagent.rc $root/bin
cp $manifest $root/controller/manifest.tsv

snapshot_repo $root/repo-src

echo split-manifest
nodestr=$"nodes
awk '
BEGIN {
	out = ARGV[1]
	nodes = ARGV[2]
	localbase = ARGV[3]
	ARGV[1] = ""
	ARGV[2] = ""
	ARGV[3] = ""
	n = split(nodes, node, " ")
}
NR == 1 {
	header = $0
	for(i = 1; i <= n; i++) {
		file = out "/" node[i] ".manifest.tsv"
		print header > file
	}
	next
}
{
	i = ((NR - 2) % n) + 1
	file = out "/" node[i] ".manifest.tsv"
	print $0 >> file
	count[i]++
}
END {
	nodesfile = out "/../nodes.tab"
	print "node\tshard_id\ttask_count\tmanifest_path\tlocal_root\tstatus\tcreated_at" > nodesfile
	for(i = 1; i <= n; i++) {
		file = out "/" node[i] ".manifest.tsv"
		print node[i] "\tshard-" i "\t" count[i] "\t" file "\t" localbase "/o9mut.shard-" i "." node[i] "\tplanned\t0" >> nodesfile
	}
}' $sharddir $nodestr $localbase $root/controller/manifest.tsv
if(! test -e $root/controller/nodes.tab)
	exit split

prepareids=()
for(i in `{seq 1 $#nodes}){
	node=$nodes($i)
	shardid=shard-$i
	localroot=$localbase/o9mut.$shardid.$node
	shardmanifest=$sharddir/$node.manifest.tsv
	id=prepare.$shardid.$pid
	log=$root/logs/prepare.$node.out
	echo prepare-shard $node $localroot
	agent_cmd $node $id prepare-shard $localroot $root/bin $root/repo-src - - - - - - - $log $shardid $shardmanifest $localroot
	prepareids=($prepareids $node/$id)
}

echo 'agent launch mode: start one agent per node if it is not already running:'
for(node in $nodes)
	echo '  9fs babyFileServer.rentonsoftworks.coin; '$root'/bin/o9mutagent.rc -r '$root' -n '$node

if(~ $waitprepare 1){
	echo wait-prepare
	wait_agent_ids prepare-shard $prepareids
	echo prepare-complete
}

startids=()
for(i in `{seq 1 $#nodes}){
	node=$nodes($i)
	shardid=shard-$i
	localroot=$localbase/o9mut.$shardid.$node
	localbin=$localroot/bin
	localrepo=$localroot/repo-src
	qid=startq.$shardid.$pid
	qworker=$node^'-queue'
	qlog=$localroot/logs/launchq.$node.out
	echo start-queue $node $localroot
	agent_cmd $node $qid start-queue $localroot $localbin $localrepo $qworker - 1000 $queuemax - - - $qlog $shardid - $localroot
	startids=($startids $node/$qid)
	for(w in `{seq 1 $workers}){
		worker=$node^-$w
		id=startw.$shardid.$w.$pid
		log=$localroot/logs/launch.$worker.out
		echo start-worker $node $worker
		agent_cmd $node $id start-worker $localroot $localbin $localrepo $worker $jobs 5000 - - - - $log $shardid - $localroot
		startids=($startids $node/$id)
	}
}

echo wait-start
wait_agent_ids start-shard $startids
echo decentralized-launched
echo 'controller root: '$root
echo 'node-local roots:'
for(i in `{seq 1 $#nodes}){
	node=$nodes($i)
	echo '  '$node'	'$localbase/o9mut.shard-$i.$node
}
echo 'monitor node roots with o9mutctl status on each node-local root.'
echo 'collect a drained shard by queuing collect-shard with local_root and collect_root='$collectroot

exit ''
