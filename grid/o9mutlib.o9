import "stdlib/process.o9";
import "stdlib/time.o9";

function O9MutDefaultRootRaw() string {
    string out;

    c {
        char *v;

        v = getenv("O9MUT_ROOT");
        if(v != nil && v[0] != '\0'){
            out = o9_string_from_c(v);
            free(v);
        } else {
            out = o9_string_from_c("/n/babyFileServer.rentonsoftworks.coin/o9mut");
        }
    }
    return out;
}

function O9MutDefaultWorkerRaw() string {
    string out;

    c {
        char *s, *u;
        char buf[128];

        s = getenv("sysname");
        u = getuser();
        if(s == nil || s[0] == '\0')
            snprint(buf, sizeof buf, "worker-%d", getpid());
        else
            snprint(buf, sizeof buf, "%s.%s.%d", s, u != nil ? u : "none", getpid());
        out = o9_string_from_c(buf);
        free(s);
    }
    return out;
}

function O9MutInitRaw(string root) int64 {
    int64 ok;

    c {
        char *r;
        char path[1024];
        int fd;
        Dir *d;

        ok = 0;
        r = o9_string_cstr(root);
        if(r != nil && r[0] != '\0'){
            fd = create(r, OREAD, DMDIR|0755);
            if(fd >= 0) close(fd);

            snprint(path, sizeof path, "%s/tasks", r);
            fd = create(path, OREAD, DMDIR|0755); if(fd >= 0) close(fd);
            snprint(path, sizeof path, "%s/tasks/pending", r);
            fd = create(path, OREAD, DMDIR|0755); if(fd >= 0) close(fd);
            snprint(path, sizeof path, "%s/tasks/claimed", r);
            fd = create(path, OREAD, DMDIR|0755); if(fd >= 0) close(fd);
            snprint(path, sizeof path, "%s/tasks/done", r);
            fd = create(path, OREAD, DMDIR|0755); if(fd >= 0) close(fd);
            snprint(path, sizeof path, "%s/queue", r);
            fd = create(path, OREAD, DMDIR|0755); if(fd >= 0) close(fd);
            snprint(path, sizeof path, "%s/queue/chunks", r);
            fd = create(path, OREAD, DMDIR|0755); if(fd >= 0) close(fd);
            snprint(path, sizeof path, "%s/queue/chunks/pending", r);
            fd = create(path, OREAD, DMDIR|0755); if(fd >= 0) close(fd);
            snprint(path, sizeof path, "%s/queue/chunks/claimed", r);
            fd = create(path, OREAD, DMDIR|0755); if(fd >= 0) close(fd);
            snprint(path, sizeof path, "%s/queue/chunks/done", r);
            fd = create(path, OREAD, DMDIR|0755); if(fd >= 0) close(fd);
            snprint(path, sizeof path, "%s/workers", r);
            fd = create(path, OREAD, DMDIR|0755); if(fd >= 0) close(fd);
            snprint(path, sizeof path, "%s/results", r);
            fd = create(path, OREAD, DMDIR|0755); if(fd >= 0) close(fd);
            snprint(path, sizeof path, "%s/logs", r);
            fd = create(path, OREAD, DMDIR|0755); if(fd >= 0) close(fd);
            snprint(path, sizeof path, "%s/repo", r);
            fd = create(path, OREAD, DMDIR|0755); if(fd >= 0) close(fd);
            snprint(path, sizeof path, "%s/mutants", r);
            fd = create(path, OREAD, DMDIR|0755); if(fd >= 0) close(fd);
            snprint(path, sizeof path, "%s/reports", r);
            fd = create(path, OREAD, DMDIR|0755); if(fd >= 0) close(fd);

            snprint(path, sizeof path, "%s/config.tab", r);
            if(access(path, 0) < 0){
                fd = create(path, OWRITE, 0644);
                if(fd >= 0){
                    fprint(fd, "key\tvalue\nschema\to9mut-grid-v1\nheartbeat_sec\t30\nstale_sec\t300\nmax_attempts\t3\n");
                    close(fd);
                }
            }
            snprint(path, sizeof path, "%s/journal.log", r);
            if(access(path, 0) < 0){
                fd = create(path, OWRITE, 0644);
                if(fd >= 0)
                    close(fd);
            }
            ok = 1;
            snprint(path, sizeof path, "%s/tasks/pending", r);
            d = dirstat(path);
            if(d == nil)
                ok = 0;
            else
                free(d);
            snprint(path, sizeof path, "%s/results", r);
            d = dirstat(path);
            if(d == nil)
                ok = 0;
            else
                free(d);
            snprint(path, sizeof path, "%s/logs", r);
            d = dirstat(path);
            if(d == nil)
                ok = 0;
            else
                free(d);
        }
        free(r);
    }
    return ok;
}

function O9MutEnqueueRaw(string root, string taskId, string source, string mutantPath, string gate, string timeoutMs, string priority) string {
    string out;

    c {
        char *r, *tid, *src, *mut, *g, *to, *prio, *p;
        char idbuf[128], path[1024], jpath[1024], detail[1024];
        int fd;

        out = o9_string_from_c("enqueue failed\n");
        r = o9_string_cstr(root);
        tid = o9_string_cstr(taskId);
        src = o9_string_cstr(source);
        mut = o9_string_cstr(mutantPath);
        g = o9_string_cstr(gate);
        to = o9_string_cstr(timeoutMs);
        prio = o9_string_cstr(priority);
        if(r != nil && src != nil && mut != nil && g != nil && to != nil && prio != nil){
            if(tid == nil || tid[0] == '\0'){
                snprint(idbuf, sizeof idbuf, "task.%lld.%d", (vlong)nsec(), getpid());
                free(tid);
                tid = strdup(idbuf);
            }
            for(p = tid; p != nil && *p != '\0'; p++) if(*p == '\t' || *p == '\n' || *p == '\r' || *p == '/') *p = '_';
            for(p = src; p != nil && *p != '\0'; p++) if(*p == '\t' || *p == '\n' || *p == '\r') *p = ' ';
            for(p = mut; p != nil && *p != '\0'; p++) if(*p == '\t' || *p == '\n' || *p == '\r') *p = ' ';
            for(p = g; p != nil && *p != '\0'; p++) if(*p == '\t' || *p == '\n' || *p == '\r') *p = ' ';
            for(p = to; p != nil && *p != '\0'; p++) if(*p == '\t' || *p == '\n' || *p == '\r') *p = ' ';
            for(p = prio; p != nil && *p != '\0'; p++) if(*p == '\t' || *p == '\n' || *p == '\r') *p = ' ';
            snprint(path, sizeof path, "%s/tasks/pending/%s.tab", r, tid);
            fd = create(path, OWRITE, 0644);
            if(fd >= 0){
                fprint(fd, "task_id\tsource\tmutant_path\tgate\ttimeout_ms\tpriority\tattempt\tcreated_at\n");
                fprint(fd, "%s\t%s\t%s\t%s\t%s\t%s\t0\t%lld\n", tid, src, mut, g, to, prio, (vlong)time(0));
                close(fd);
                snprint(jpath, sizeof jpath, "%s/journal.log", r);
                snprint(detail, sizeof detail, "source=%s\tmutant_path=%s\tgate=%s\ttimeout_ms=%s\tattempt=0", src, mut, g, to);
                o9_append_event(jpath, "ctl", "enqueue", "task", tid, detail);
                snprint(path, sizeof path, "enqueued %s\n", tid);
                out = o9_string_from_c(path);
            }
        }
        free(r); free(tid); free(src); free(mut); free(g); free(to); free(prio);
    }
    return out;
}

function O9MutManifestRaw(string root, string manifest) string {
    string out;

    c {
        char *r, *m, *buf, *line, *next, *fields[6], *s, *chunkenv;
        char path[1024], idbuf[256], manifestmsg[256], countpath[1024], jpath[1024], detail[256];
        Dir *st;
        int fd, chunkfd, rn, off, want, i, nfields, count, skipped, header, chunks, chunkRows, chunkSize;
        vlong len;

        out = o9_string_from_c("manifest failed\n");
        r = o9_string_cstr(root);
        m = o9_string_cstr(manifest);
        buf = nil;
        count = skipped = 0;
        chunks = chunkRows = 0;
        chunkfd = -1;
        chunkSize = 256;
        chunkenv = getenv("O9MUT_CHUNK_LINES");
        if(chunkenv != nil && chunkenv[0] != '\0'){
            chunkSize = atoi(chunkenv);
            if(chunkSize < 1)
                chunkSize = 256;
        }
        free(chunkenv);
        if(r != nil && m != nil && r[0] != '\0' && m[0] != '\0'){
            st = dirstat(m);
            if(st != nil){
                len = st->length;
                free(st);
                fd = open(m, OREAD);
                if(fd >= 0){
                    buf = malloc(len + 2);
                    if(buf != nil){
                        off = 0;
                        while(off < len){
                            want = len - off;
                            if(want > 8192)
                                want = 8192;
                            rn = read(fd, buf + off, want);
                            if(rn <= 0)
                                break;
                            off += rn;
                        }
                        buf[off] = '\0';
                    }
                    close(fd);
                }
            }
        }
        if(buf != nil){
            header = 1;
            for(line = buf; line != nil && *line != '\0'; line = next){
                next = strchr(line, '\n');
                if(next != nil)
                    *next++ = '\0';
                if(line[0] == '\0')
                    continue;
                if(header){
                    header = 0;
                    continue;
                }
                for(i = 0; i < 6; i++) fields[i] = "";
                fields[0] = line;
                nfields = 1;
                for(s = line; *s != '\0' && nfields < 6; s++){
                    if(*s == '\t'){
                        *s = '\0';
                        fields[nfields++] = s + 1;
                    } else if(*s == '\r') {
                        *s = '\0';
                        break;
                    }
                }
                if(nfields < 6 || fields[0][0] == '\0' || fields[3][0] == '\0'){
                    skipped++;
                    continue;
                }
                snprint(idbuf, sizeof idbuf, "%s", fields[0]);
                for(s = idbuf; *s != '\0'; s++)
                    if(*s == '/' || *s == '\t' || *s == '\n' || *s == '\r')
                        *s = '_';
                if(chunkfd < 0 || chunkRows >= chunkSize){
                    if(chunkfd >= 0)
                        close(chunkfd);
                    snprint(path, sizeof path, "%s/queue/chunks/pending/chunk.%06d.tab", r, chunks);
                    chunkfd = create(path, OWRITE, 0644);
                    if(chunkfd < 0){
                        skipped++;
                        continue;
                    }
                    chunks++;
                    chunkRows = 0;
                }
                fprint(chunkfd, "%s\t%s\t%s\t%s\t%s\t%s\n",
                    idbuf, fields[1], fields[2], fields[3], fields[4], fields[5]);
                chunkRows++;
                count++;
            }
            if(chunkfd >= 0){
                close(chunkfd);
                chunkfd = -1;
            }
            snprint(countpath, sizeof countpath, "%s/queue/counts.tab", r);
            fd = create(countpath, OWRITE, 0644);
            if(fd >= 0){
                fprint(fd, "key\tvalue\nmanifest_enqueued\t%d\nmanifest_skipped\t%d\nmanifest_chunks\t%d\nchunk_size\t%d\n", count, skipped, chunks, chunkSize);
                close(fd);
            }
            snprint(manifestmsg, sizeof manifestmsg, "manifest_enqueued\t%d\nmanifest_skipped\t%d\nmanifest_chunks\t%d\nchunk_size\t%d\n", count, skipped, chunks, chunkSize);
            out = o9_string_from_c(manifestmsg);
            snprint(jpath, sizeof jpath, "%s/journal.log", r);
            snprint(detail, sizeof detail, "manifest_enqueued=%d\tmanifest_skipped=%d\tmanifest_chunks=%d", count, skipped, chunks);
            o9_append_event(jpath, "ctl", "manifest_chunked", "manifest", m, detail);
        }
        if(chunkfd >= 0)
            close(chunkfd);
        free(buf);
        free(r); free(m);
    }
    return out;
}

function O9MutStatusRaw(string root, int64 bySource, int64 workers, int64 fromJournal) string {
    string out;

    c {
        char *r;
        char path[1024], rpath[1024], *buf, result[64], source[256], taskid[128], detail[1024];
        char *p, *srcs, *jbuf, *line, *next, *fields[6], *evtype, *evkind, *evdetail;
        char *outs[2]; const char *names[2]; int sizes[2];
        Dir *dirs;
        int fd, n, rn, i, pending, claimed, done, killed, survived, timeout, equivalent, infra, setup, chunkPending, chunkClaimed, chunkDone;
        int nsrc, si, heartbeatSec, buflen;
        long manifestTotal, now, lastSeen, age;
        long *spending, *sclaimed, *skilled, *ssurvived, *stimeout, *sequiv, *sinfra, *ssetup;

        r = o9_string_cstr(root);
        pending = claimed = done = killed = survived = timeout = equivalent = infra = setup = 0;
        chunkPending = chunkClaimed = chunkDone = 0;
        manifestTotal = 0;
        buflen = 65536;
        buf = malloc(buflen);
        srcs = malloc(256 * 256);
        spending = malloc(sizeof(long) * 256);
        sclaimed = malloc(sizeof(long) * 256);
        skilled = malloc(sizeof(long) * 256);
        ssurvived = malloc(sizeof(long) * 256);
        stimeout = malloc(sizeof(long) * 256);
        sequiv = malloc(sizeof(long) * 256);
        sinfra = malloc(sizeof(long) * 256);
        ssetup = malloc(sizeof(long) * 256);
        nsrc = 0;
        if(srcs == nil || spending == nil || sclaimed == nil || skilled == nil || ssurvived == nil || stimeout == nil || sequiv == nil || sinfra == nil || ssetup == nil)
            bySource = 0;
        for(i = 0; i < 256; i++){
            if(srcs != nil)
                (srcs + i * 256)[0] = '\0';
            if(spending != nil) spending[i] = 0;
            if(sclaimed != nil) sclaimed[i] = 0;
            if(skilled != nil) skilled[i] = 0;
            if(ssurvived != nil) ssurvived[i] = 0;
            if(stimeout != nil) stimeout[i] = 0;
            if(sequiv != nil) sequiv[i] = 0;
            if(sinfra != nil) sinfra[i] = 0;
            if(ssetup != nil) ssetup[i] = 0;
        }

        #define SRCIDX(src, idx) do { \
            for((idx) = 0; (idx) < nsrc; (idx)++) \
                if(strcmp(srcs + (idx) * 256, (src)) == 0) \
                    break; \
            if((idx) == nsrc && nsrc < 256){ \
                snprint(srcs + nsrc * 256, 256, "%s", (src)); \
                (idx) = nsrc++; \
            } \
        } while(0)
        #define DETAILKEY(d, key, outv, outn) do { \
            char *_d=(d), *_p, *_q; (outv)[0]='\0'; \
            _p = strstr(_d, (key)); \
            while(_p != nil){ \
                if((_p == _d || _p[-1] == '\t') && _p[strlen(key)] == '='){ \
                    _p += strlen(key) + 1; \
                    _q = strchr(_p, '\t'); \
                    { int _l = _q ? (int)(_q - _p) : (int)strlen(_p); \
                      if(_l >= (outn)) _l = (outn) - 1; \
                      memmove((outv), _p, _l); (outv)[_l] = '\0'; } \
                    break; \
                } \
                _p = strstr(_p + 1, (key)); \
            } \
        } while(0)

        if(r != nil){
            snprint(path, sizeof path, "%s/tasks/pending", r);
            pending = o9_count_dir(path, 0, ".tab");
            snprint(path, sizeof path, "%s/tasks/claimed", r);
            claimed = o9_count_dir(path, 1, nil);
            snprint(path, sizeof path, "%s/queue/chunks/pending", r);
            chunkPending = o9_count_dir(path, 0, ".tab");
            snprint(path, sizeof path, "%s/queue/chunks/claimed", r);
            chunkClaimed = o9_count_dir(path, 1, nil);
            snprint(path, sizeof path, "%s/queue/chunks/done", r);
            chunkDone = o9_count_dir(path, 0, ".tab");
            snprint(path, sizeof path, "%s/results", r);
            done = o9_count_dir(path, 0, ".tab");

            if(fromJournal){
                snprint(path, sizeof path, "%s/journal.log", r);
                fd = open(path, OREAD);
                if(fd >= 0){
                    jbuf = malloc(65536);
                    if(jbuf != nil){
                        rn = read(fd, jbuf, 65535);
                        if(rn < 0) rn = 0;
                        jbuf[rn] = '\0';
                        for(line = jbuf; line != nil && *line != '\0'; line = next){
                            next = strchr(line, '\n');
                            if(next != nil)
                                *next++ = '\0';
                            if(line[0] == '\0')
                                continue;
                            evdetail = "";
                            o9_journal_split(line, fields, 6, &evdetail);
                            evtype = fields[3];
                            evkind = fields[4];
                            if(strcmp(evtype, "gate_exit") != 0 || strcmp(evkind, "task") != 0)
                                continue;
                            DETAILKEY(evdetail, "result", result, sizeof result);
                            if(strcmp(result, "killed") == 0) killed++;
                            else if(strcmp(result, "survived") == 0) survived++;
                            else if(strcmp(result, "timeout") == 0) timeout++;
                            else if(strcmp(result, "equivalent") == 0) equivalent++;
                            else if(strcmp(result, "infra_fail") == 0) infra++;
                            else if(strcmp(result, "setup_error") == 0) setup++;
                        }
                        free(jbuf);
                    }
                    close(fd);
                }
            } else {
                snprint(path, sizeof path, "%s/results", r);
                fd = open(path, OREAD);
                if(fd >= 0){
                    dirs = nil;
                    n = dirreadall(fd, &dirs);
                    close(fd);
                    for(i = 0; i < n; i++){
                        if((dirs[i].mode & DMDIR) != 0 || !o9_has_suffix(dirs[i].name, ".tab"))
                            continue;
                        snprint(rpath, sizeof rpath, "%s/results/%s", r, dirs[i].name);
                        result[0] = source[0] = '\0';
                        names[0] = "result"; outs[0] = result; sizes[0] = sizeof result;
                        names[1] = "source"; outs[1] = source; sizes[1] = sizeof source;
                        o9_tsv_get_cols(rpath, names, outs, sizes, 2);
                        if(strcmp(result, "killed") == 0) killed++;
                        else if(strcmp(result, "survived") == 0) survived++;
                        else if(strcmp(result, "timeout") == 0) timeout++;
                        else if(strcmp(result, "equivalent") == 0) equivalent++;
                        else if(strcmp(result, "infra_fail") == 0) infra++;
                        else if(strcmp(result, "setup_error") == 0) setup++;
                        if(bySource && source[0] != '\0' && srcs != nil){
                            SRCIDX(source, si);
                            if(si < 256){
                                if(strcmp(result, "killed") == 0) skilled[si]++;
                                else if(strcmp(result, "survived") == 0) ssurvived[si]++;
                                else if(strcmp(result, "timeout") == 0) stimeout[si]++;
                                else if(strcmp(result, "equivalent") == 0) sequiv[si]++;
                                else if(strcmp(result, "infra_fail") == 0) sinfra[si]++;
                                else if(strcmp(result, "setup_error") == 0) ssetup[si]++;
                            }
                        }
                    }
                    free(dirs);
                }
            }

            if(bySource && fromJournal && srcs != nil){
                snprint(path, sizeof path, "%s/results", r);
                fd = open(path, OREAD);
                if(fd >= 0){
                    dirs = nil;
                    n = dirreadall(fd, &dirs);
                    close(fd);
                    for(i = 0; i < n; i++){
                        if((dirs[i].mode & DMDIR) != 0 || !o9_has_suffix(dirs[i].name, ".tab"))
                            continue;
                        snprint(rpath, sizeof rpath, "%s/results/%s", r, dirs[i].name);
                        result[0] = source[0] = '\0';
                        names[0] = "result"; outs[0] = result; sizes[0] = sizeof result;
                        names[1] = "source"; outs[1] = source; sizes[1] = sizeof source;
                        o9_tsv_get_cols(rpath, names, outs, sizes, 2);
                        if(source[0] != '\0'){
                            SRCIDX(source, si);
                            if(si < 256){
                                if(strcmp(result, "killed") == 0) skilled[si]++;
                                else if(strcmp(result, "survived") == 0) ssurvived[si]++;
                                else if(strcmp(result, "timeout") == 0) stimeout[si]++;
                                else if(strcmp(result, "equivalent") == 0) sequiv[si]++;
                                else if(strcmp(result, "infra_fail") == 0) sinfra[si]++;
                                else if(strcmp(result, "setup_error") == 0) ssetup[si]++;
                            }
                        }
                    }
                    free(dirs);
                }
            }

            if(bySource && srcs != nil){
                snprint(path, sizeof path, "%s/tasks/pending", r);
                fd = open(path, OREAD);
                if(fd >= 0){
                    dirs = nil;
                    n = dirreadall(fd, &dirs);
                    close(fd);
                    for(i = 0; i < n; i++){
                        if((dirs[i].mode & DMDIR) != 0 || !o9_has_suffix(dirs[i].name, ".tab"))
                            continue;
                        snprint(rpath, sizeof rpath, "%s/tasks/pending/%s", r, dirs[i].name);
                        source[0] = '\0';
                        o9_tsv_get_col(rpath, "source", source, sizeof source);
                        if(source[0] != '\0'){
                            SRCIDX(source, si);
                            if(si < 256) spending[si]++;
                        }
                    }
                    free(dirs);
                }
                snprint(path, sizeof path, "%s/tasks/claimed", r);
                fd = open(path, OREAD);
                if(fd >= 0){
                    dirs = nil;
                    n = dirreadall(fd, &dirs);
                    close(fd);
                    for(i = 0; i < n; i++){
                        if((dirs[i].mode & DMDIR) == 0)
                            continue;
                        snprint(rpath, sizeof rpath, "%s/tasks/pending/%s.tab", r, dirs[i].name);
                        source[0] = '\0';
                        o9_tsv_get_col(rpath, "source", source, sizeof source);
                        if(source[0] != '\0'){
                            SRCIDX(source, si);
                            if(si < 256) sclaimed[si]++;
                        }
                    }
                    free(dirs);
                }
            }

            snprint(path, sizeof path, "%s/queue/counts.tab", r);
            manifestTotal = o9_kv_int(path, "manifest_enqueued", 0);
        }
        if(buf == nil)
            out = o9_string_from_c("status failed\n");
        if(buf == nil){
            goto sdone;
        }
        p = buf;
        p = seprint(p, buf + buflen, "o9mut grid status\n");
        p = seprint(p, buf + buflen, "root\t%s\n", r != nil ? r : "");
        p = seprint(p, buf + buflen, "pending\t%d\nclaimed\t%d\ndone\t%d\n", pending, claimed, done);
        p = seprint(p, buf + buflen, "chunks_pending\t%d\nchunks_claimed\t%d\nchunks_done\t%d\n", chunkPending, chunkClaimed, chunkDone);
        p = seprint(p, buf + buflen, "killed\t%d\nsurvived\t%d\ntimeout\t%d\nequivalent\t%d\ninfra_fail\t%d\nsetup_error\t%d\n",
            killed, survived, timeout, equivalent, infra, setup);
        if(manifestTotal > 0)
            p = seprint(p, buf + buflen, "progress\t%d/%ld\n", done, manifestTotal);
        if(bySource && srcs != nil){
            p = seprint(p, buf + buflen, "by_source\n");
            for(si = 0; si < nsrc; si++){
                long fin = skilled[si] + ssurvived[si];
                p = seprint(p, buf + buflen, "source\t%s\n", srcs + si * 256);
                p = seprint(p, buf + buflen, "pending\t%ld\nclaimed\t%ld\n", spending[si], sclaimed[si]);
                p = seprint(p, buf + buflen, "killed\t%ld\nsurvived\t%ld\ntimeout\t%ld\nequivalent\t%ld\ninfra_fail\t%ld\nsetup_error\t%ld\n",
                    skilled[si], ssurvived[si], stimeout[si], sequiv[si], sinfra[si], ssetup[si]);
                if(fin > 0)
                    p = seprint(p, buf + buflen, "score\t%.2f\n", (double)skilled[si] / (double)fin);
                else
                    p = seprint(p, buf + buflen, "score\tn/a\n");
            }
        }
        if(workers && r != nil){
            snprint(path, sizeof path, "%s/config.tab", r);
            heartbeatSec = o9_kv_int(path, "heartbeat_sec", 30);
            if(heartbeatSec <= 0)
                heartbeatSec = 30;
            now = time(0);
            p = seprint(p, buf + buflen, "workers\n");
            if(fromJournal){
                char *wids, *wstate, *wtask;
                vlong *wseen;
                int nw, wi;

                wids = malloc(256 * 128);
                wstate = malloc(256 * 32);
                wtask = malloc(256 * 128);
                wseen = malloc(sizeof(vlong) * 256);
                nw = 0;
                if(wids != nil && wstate != nil && wtask != nil && wseen != nil){
                    for(i = 0; i < 256; i++){
                        (wids + i * 128)[0] = '\0';
                        snprint(wstate + i * 32, 32, "unknown");
                        (wtask + i * 128)[0] = '\0';
                        wseen[i] = 0;
                    }
                    snprint(path, sizeof path, "%s/journal.log", r);
                    fd = open(path, OREAD);
                    if(fd >= 0){
                        jbuf = malloc(65536);
                        if(jbuf != nil){
                            rn = read(fd, jbuf, 65535);
                            if(rn < 0) rn = 0;
                            jbuf[rn] = '\0';
                            for(line = jbuf; line != nil && *line != '\0'; line = next){
                                next = strchr(line, '\n');
                                if(next != nil)
                                    *next++ = '\0';
                                if(line[0] == '\0')
                                    continue;
                                evdetail = "";
                                o9_journal_split(line, fields, 6, &evdetail);
                                evtype = fields[3];
                                evkind = fields[4];
                                taskid[0] = '\0';
                                if(strcmp(evtype, "drain_requested") == 0 && strcmp(evkind, "worker") == 0)
                                    snprint(taskid, sizeof taskid, "%s", fields[5]);
                                else if(strcmp(evtype, "worker_start") == 0 || strcmp(evtype, "worker_heartbeat") == 0 || strcmp(evtype, "worker_stop") == 0 || strcmp(evtype, "worker_drain") == 0)
                                    snprint(taskid, sizeof taskid, "%s", fields[2]);
                                if(taskid[0] == '\0')
                                    continue;
                                for(wi = 0; wi < nw; wi++)
                                    if(strcmp(wids + wi * 128, taskid) == 0)
                                        break;
                                if(wi == nw && nw < 256){
                                    snprint(wids + nw * 128, 128, "%s", taskid);
                                    wi = nw++;
                                }
                                if(wi >= 256)
                                    continue;
                                wseen[wi] = strtoll(fields[1], nil, 10);
                                if(strcmp(evtype, "worker_start") == 0)
                                    snprint(wstate + wi * 32, 32, "running");
                                else if(strcmp(evtype, "worker_heartbeat") == 0){
                                    result[0] = '\0';
                                    source[0] = '\0';
                                    DETAILKEY(evdetail, "status", result, sizeof result);
                                    DETAILKEY(evdetail, "task", source, sizeof source);
                                    if(result[0] != '\0')
                                        snprint(wstate + wi * 32, 32, "%s", result);
                                    if(source[0] != '\0')
                                        snprint(wtask + wi * 128, 128, "%s", source);
                                } else if(strcmp(evtype, "worker_stop") == 0)
                                    snprint(wstate + wi * 32, 32, "stopped");
                                else if(strcmp(evtype, "worker_drain") == 0 || strcmp(evtype, "drain_requested") == 0)
                                    snprint(wstate + wi * 32, 32, "drained");
                            }
                            free(jbuf);
                        }
                        close(fd);
                    }
                    for(wi = 0; wi < nw; wi++){
                        p = seprint(p, buf + buflen, "worker\t%s\tstatus=%s\tlast_event_ms=%lld", wids + wi * 128, wstate + wi * 32, wseen[wi]);
                        if((wtask + wi * 128)[0] != '\0')
                            p = seprint(p, buf + buflen, "\tcurrent_task=%s", wtask + wi * 128);
                        p = seprint(p, buf + buflen, "\n");
                    }
                }
                free(wids); free(wstate); free(wtask); free(wseen);
            } else {
                snprint(path, sizeof path, "%s/workers", r);
                fd = open(path, OREAD);
                if(fd >= 0){
                    dirs = nil;
                    n = dirreadall(fd, &dirs);
                    close(fd);
                    for(i = 0; i < n; i++){
                        if((dirs[i].mode & DMDIR) != 0 || !o9_has_suffix(dirs[i].name, ".tab"))
                            continue;
                        snprint(rpath, sizeof rpath, "%s/workers/%s", r, dirs[i].name);
                        taskid[0] = source[0] = result[0] = '\0';
                        names[0] = "worker_id"; outs[0] = taskid; sizes[0] = sizeof taskid;
                        names[1] = "status"; outs[1] = result; sizes[1] = sizeof result;
                        o9_tsv_get_cols(rpath, names, outs, sizes, 2);
                        source[0] = '\0';
                        o9_tsv_get_col(rpath, "current_task", source, sizeof source);
                        detail[0] = '\0';
                        o9_tsv_get_col(rpath, "last_seen", detail, sizeof detail);
                        lastSeen = strtol(detail, nil, 10);
                        age = lastSeen > 0 ? now - lastSeen : 0;
                        if(result[0] == '\0')
                            snprint(result, sizeof result, "unknown");
                        if(lastSeen > 0 && age > heartbeatSec * 2)
                            snprint(result, sizeof result, "dead");
                        p = seprint(p, buf + buflen, "worker\t%s\tstatus=%s\tlast_seen_age=%ld", taskid[0] ? taskid : dirs[i].name, result, age);
                        if(source[0] != '\0')
                            p = seprint(p, buf + buflen, "\tcurrent_task=%s", source);
                        p = seprint(p, buf + buflen, "\n");
                    }
                    free(dirs);
                }
            }
        }
        out = o9_string_from_c(buf);
        sdone:
        #undef SRCIDX
        #undef DETAILKEY
        free(buf);
        free(srcs);
        free(spending); free(sclaimed); free(skilled); free(ssurvived); free(stimeout); free(sequiv); free(sinfra); free(ssetup);
        free(r);
    }
    return out;
}

function O9MutRequeueStaleRaw(string root, int64 staleSec) string {
    string out;

    c {
        char *r;
        char path[1024], child[1024], claim[1024], buf[2048], jpath[1024], detail[256];
        char cfg[1024], pending[1024], resultpath[1024], donepath[1024], *taskbuf, *row, *fields[8], *s;
        Dir *dirs;
        int fd, n, i, j, rn, requeued_chunks, requeued_tasks, retired, finalized, gotrow;
        long now, maxattempts, attempt;

        r = o9_string_cstr(root);
        requeued_chunks = requeued_tasks = retired = finalized = 0;
        now = time(0);
        if(r != nil){
            snprint(jpath, sizeof jpath, "%s/journal.log", r);
            snprint(cfg, sizeof cfg, "%s/config.tab", r);
            maxattempts = o9_kv_int(cfg, "max_attempts", 3);
            if(staleSec <= 0)
                staleSec = o9_kv_int(cfg, "stale_sec", 300);

            /* Chunk claims: a stale claim means the queue worker died mid-chunk.
             * The chunk pending file is removed only after its done marker
             * (Invariant 1), so it is still on disk — drop the stale claim and
             * another queue worker re-claims it. If a done marker already
             * landed the chunk is finished; just reap the orphaned claim dir. */
            snprint(path, sizeof path, "%s/queue/chunks/claimed", r);
            fd = open(path, OREAD);
            if(fd >= 0){
                dirs = nil;
                n = dirreadall(fd, &dirs);
                close(fd);
                for(i = 0; i < n; i++){
                    if((dirs[i].mode & DMDIR) == 0)
                        continue;
                    if(now - dirs[i].mtime < staleSec)
                        continue;
                    snprint(donepath, sizeof donepath, "%s/queue/chunks/done/%s", r, dirs[i].name);
                    snprint(child, sizeof child, "%s/queue/chunks/claimed/%s", r, dirs[i].name);
                    if(access(donepath, 0) == 0){
                        remove(child);
                        continue;
                    }
                    remove(child);
                    o9_append_event(jpath, "ctl", "chunk_requeue", "chunk", dirs[i].name, "reason=stale_claim");
                    requeued_chunks++;
                }
                free(dirs);
            }

            /* Task claims: a stale claim means a task worker died mid-task.
             * The pending file is removed only after the done marker, so the
             * task is still pending. If a result was already written, finalize
             * it (done marker + reap). Otherwise bump the attempt counter and
             * requeue — unless attempt exceeds max_attempts, in which case
             * retire the task as infra_fail so it cannot loop forever. */
            snprint(path, sizeof path, "%s/tasks/claimed", r);
            fd = open(path, OREAD);
            if(fd >= 0){
                dirs = nil;
                n = dirreadall(fd, &dirs);
                close(fd);
                for(i = 0; i < n; i++){
                    if((dirs[i].mode & DMDIR) == 0)
                        continue;
                    if(now - dirs[i].mtime < staleSec)
                        continue;
                    snprint(resultpath, sizeof resultpath, "%s/results/%s.tab", r, dirs[i].name);
                    snprint(pending, sizeof pending, "%s/tasks/pending/%s.tab", r, dirs[i].name);
                    snprint(donepath, sizeof donepath, "%s/tasks/done/%s.tab", r, dirs[i].name);
                    snprint(claim, sizeof claim, "%s/tasks/claimed/%s/claim.tab", r, dirs[i].name);
                    snprint(child, sizeof child, "%s/tasks/claimed/%s", r, dirs[i].name);

                    if(access(resultpath, 0) == 0){
                        /* worker wrote the result but crashed before finalize */
                        fd = create(donepath, OWRITE, 0644);
                        if(fd >= 0){
                            fprint(fd, "task_id\tworker_id\tfinished_at\n%s\trecovery\t%lld\n", dirs[i].name, (vlong)now);
                            close(fd);
                        }
                        remove(pending);
                        remove(claim);
                        remove(child);
                        o9_append_event(jpath, "ctl", "task_done", "task", dirs[i].name, "result=recovered");
                        finalized++;
                        continue;
                    }

                    /* read the attempt counter from the pending file */
                    attempt = 0;
                    gotrow = 0;
                    taskbuf = nil;
                    fd = open(pending, OREAD);
                    if(fd >= 0){
                        rn = read(fd, buf, sizeof buf - 1);
                        close(fd);
                        if(rn < 0) rn = 0;
                        buf[rn] = '\0';
                        taskbuf = buf;
                    }
                    if(taskbuf != nil){
                        row = strchr(taskbuf, '\n');
                        if(row != nil){
                            row++;
                            for(j = 0; j < 8; j++) fields[j] = "";
                            fields[0] = row;
                            j = 1;
                            for(s = row; *s != '\0' && j < 8; s++){
                                if(*s == '\t'){
                                    *s = '\0';
                                    fields[j++] = s + 1;
                                } else if(*s == '\n' || *s == '\r'){
                                    *s = '\0';
                                    break;
                                }
                            }
                            if(fields[0][0] != '\0'){
                                attempt = strtol(fields[6], nil, 10);
                                gotrow = 1;
                            }
                        }
                    }
                    attempt++;

                    if(!gotrow){
                        /* unreadable/corrupt pending — retire, do not loop */
                        fd = create(resultpath, OWRITE, 0644);
                        if(fd >= 0){
                            fprint(fd, "task_id\tworker_id\tsource\tmutant_path\tresult\texit_code\tseconds\tlog_path\treason\tfinished_at\n");
                            fprint(fd, "%s\trecovery\t\t\tinfra_fail\t1\t0\t\tunreadable_pending\t%lld\n", dirs[i].name, (vlong)now);
                            close(fd);
                        }
                        fd = create(donepath, OWRITE, 0644);
                        if(fd >= 0){
                            fprint(fd, "task_id\tworker_id\tfinished_at\n%s\trecovery\t%lld\n", dirs[i].name, (vlong)now);
                            close(fd);
                        }
                        remove(pending);
                        remove(claim);
                        remove(child);
                        o9_append_event(jpath, "ctl", "task_retire", "task", dirs[i].name, "reason=unreadable_pending");
                        retired++;
                        continue;
                    }

                    if(attempt > maxattempts){
                        /* exceeded retry budget — retire as infra_fail */
                        fd = create(resultpath, OWRITE, 0644);
                        if(fd >= 0){
                            fprint(fd, "task_id\tworker_id\tsource\tmutant_path\tresult\texit_code\tseconds\tlog_path\treason\tfinished_at\n");
                            fprint(fd, "%s\trecovery\t%s\t%s\tinfra_fail\t1\t0\t\tmax_attempts_exceeded\t%lld\n", dirs[i].name, fields[1], fields[2], (vlong)now);
                            close(fd);
                        }
                        fd = create(donepath, OWRITE, 0644);
                        if(fd >= 0){
                            fprint(fd, "task_id\tworker_id\tfinished_at\n%s\trecovery\t%lld\n", dirs[i].name, (vlong)now);
                            close(fd);
                        }
                        remove(pending);
                        remove(claim);
                        remove(child);
                        snprint(detail, sizeof detail, "reason=max_attempts_exceeded\tattempt=%ld", attempt);
                        o9_append_event(jpath, "ctl", "task_retire", "task", dirs[i].name, detail);
                        retired++;
                        continue;
                    }

                    /* bump attempt in the pending file and requeue */
                    fd = create(pending, OWRITE, 0644);
                    if(fd >= 0){
                        fprint(fd, "task_id\tsource\tmutant_path\tgate\ttimeout_ms\tpriority\tattempt\tcreated_at\n");
                        fprint(fd, "%s\t%s\t%s\t%s\t%s\t%s\t%ld\t%s\n",
                            fields[0], fields[1], fields[2], fields[3], fields[4], fields[5], attempt, fields[7]);
                        close(fd);
                    }
                    remove(claim);
                    remove(child);
                    snprint(detail, sizeof detail, "attempt=%ld", attempt);
                    o9_append_event(jpath, "ctl", "task_requeue", "task", dirs[i].name, detail);
                    requeued_tasks++;
                }
                free(dirs);
            }
        }
        snprint(buf, sizeof buf, "requeued_chunks\t%d\nrequeued_tasks\t%d\nretired\t%d\nfinalized\t%d\n", requeued_chunks, requeued_tasks, retired, finalized);
        out = o9_string_from_c(buf);
        free(r);
    }
    return out;
}

function O9MutDrainWorkerRaw(string root, string worker) string {
    string out;

    c {
        char *r, *w;
        char path[1024], buf[256], jpath[1024];
        int fd;

        r = o9_string_cstr(root);
        w = o9_string_cstr(worker);
        snprint(buf, sizeof buf, "drain failed\n");
        if(r != nil && w != nil && w[0] != '\0'){
            snprint(path, sizeof path, "%s/workers/%s.drain", r, w);
            fd = create(path, OWRITE, 0644);
            if(fd >= 0){
                fprint(fd, "worker\trequested_at\n%s\t%lld\n", w, (vlong)time(0));
                close(fd);
                snprint(jpath, sizeof jpath, "%s/journal.log", r);
                o9_append_event(jpath, "ctl", "drain_requested", "worker", w, "");
                snprint(buf, sizeof buf, "drain_requested\t%s\n", w);
            }
        }
        out = o9_string_from_c(buf);
        free(r); free(w);
    }
    return out;
}

function O9MutTriageRaw(string root, string output, int64 fromJournal, string repo, int64 classifyEquivalent, int64 classifyWhitespace, int64 includeMissing, string equivFile) string {
    string out;

    c {
        char *r, *op, *rp, *ep, *jbuf, *line, *next, *fields[6], *evdetail;
        char outpath[1024], path[1024], rpath[1024], triagemsg[2048], ledger[1024];
        char taskid[128], worker[128], source[512], mutant[1024], result[64], klass[64], confidence[64], suggested[256], reason[256], ledgerReason[256], candidateReason[256], diff[512];
        char *outs[5], *douts[4]; const char *names[5], *dnames[4]; int sizes[5], dsizes[4];
        Dir *dirs;
        int ofd, fd, n, rn, i, rows, selected;

        r = o9_string_cstr(root);
        op = o9_string_cstr(output);
        rp = o9_string_cstr(repo);
        ep = o9_string_cstr(equivFile);
        rows = 0;
        ofd = -1;
        out = o9_string_from_c("triage failed\n");
        if(r == nil || r[0] == '\0')
            goto tdone;
        if(op != nil && op[0] != '\0')
            snprint(outpath, sizeof outpath, "%s", op);
        else
            snprint(outpath, sizeof outpath, "%s/reports/grid_triage.tsv", r);
        if(ep != nil && ep[0] != '\0')
            snprint(ledger, sizeof ledger, "%s", ep);
        else if(rp != nil && rp[0] != '\0')
            snprint(ledger, sizeof ledger, "%s/o9c/test/mutation_equiv.tsv", rp);
        else
            snprint(ledger, sizeof ledger, "o9c/test/mutation_equiv.tsv");
        ofd = create(outpath, OWRITE, 0644);
        if(ofd < 0)
            goto tdone;
        fprint(ofd, "source\tmutant\tresult\tfunction\toriginal_line\tmutant_line\ttriage_class\tconfidence\tsuggested_action\treason\tdiff_summary\n");

        names[0] = "task_id"; outs[0] = taskid; sizes[0] = sizeof taskid;
        names[1] = "worker_id"; outs[1] = worker; sizes[1] = sizeof worker;
        names[2] = "source"; outs[2] = source; sizes[2] = sizeof source;
        names[3] = "mutant_path"; outs[3] = mutant; sizes[3] = sizeof mutant;
        names[4] = "result"; outs[4] = result; sizes[4] = sizeof result;

        dnames[0] = "task_id"; douts[0] = taskid; dsizes[0] = sizeof taskid;
        dnames[1] = "worker_id"; douts[1] = worker; dsizes[1] = sizeof worker;
        dnames[2] = "source"; douts[2] = source; dsizes[2] = sizeof source;
        dnames[3] = "mutant_path"; douts[3] = mutant; dsizes[3] = sizeof mutant;

        #define DETKEY(d, key, outv, outn) do { \
            char *_d=(d), *_p, *_q; (outv)[0]='\0'; \
            _p = strstr(_d, (key)); \
            while(_p != nil){ \
                if((_p == _d || _p[-1] == '\t') && _p[strlen(key)] == '='){ \
                    _p += strlen(key) + 1; \
                    _q = strchr(_p, '\t'); \
                    { int _l = _q ? (int)(_q - _p) : (int)strlen(_p); \
                      if(_l >= (outn)) _l = (outn) - 1; \
                      memmove((outv), _p, _l); (outv)[_l] = '\0'; } \
                    break; \
                } \
                _p = strstr(_p + 1, (key)); \
            } \
        } while(0)
        #define CLASSIFY_TRIAGE_ROW() do { \
            selected = 0; \
            o9_strip_repo_prefix(source, rp); \
            snprint(confidence, sizeof confidence, "grid"); \
            snprint(klass, sizeof klass, "unknown"); \
            snprint(suggested, sizeof suggested, "inspect this grid result"); \
            snprint(reason, sizeof reason, "grid result"); \
            if(strcmp(result, "survived") == 0){ \
                selected = 1; \
                if(classifyEquivalent && o9_equiv_ledger_lookup(ledger, source, mutant, ledgerReason, sizeof ledgerReason)){ \
                    snprint(result, sizeof result, "equivalent"); \
                    snprint(klass, sizeof klass, "equivalent"); \
                    snprint(confidence, sizeof confidence, "exact"); \
                    snprint(suggested, sizeof suggested, "keep the exact equivalence ledger entry"); \
                    snprint(reason, sizeof reason, "already listed in the equivalence ledger"); \
                } else if(classifyWhitespace && source[0] != '\0' && mutant[0] != '\0' && o9_c_lexical_whitespace_equiv(source, mutant)){ \
                    snprint(result, sizeof result, "equivalent"); \
                    snprint(klass, sizeof klass, "equivalent"); \
                    snprint(confidence, sizeof confidence, "exact"); \
                    snprint(suggested, sizeof suggested, "no recheck unless whitespace-sensitive generated text is expected"); \
                    snprint(reason, sizeof reason, "lexical_equivalent"); \
                } else if(source[0] != '\0' && mutant[0] != '\0' && o9_equiv_candidate_reason(source, mutant, candidateReason, sizeof candidateReason)){ \
                    snprint(klass, sizeof klass, "equivalent_candidate"); \
                    snprint(confidence, sizeof confidence, "medium"); \
                    snprint(suggested, sizeof suggested, "requires review and an exact ledger entry if equivalent"); \
                    snprint(reason, sizeof reason, "%s", candidateReason[0] ? candidateReason : "likely equivalent candidate"); \
                } else { \
                    snprint(klass, sizeof klass, "test_gap"); \
                    snprint(confidence, sizeof confidence, "high"); \
                    snprint(suggested, sizeof suggested, "add or strengthen a focused test, then recheck this mutant"); \
                    snprint(reason, sizeof reason, "grid survivor"); \
                } \
            } else if(strcmp(result, "timeout") == 0){ \
                selected = 1; \
                snprint(klass, sizeof klass, "timeout"); \
                snprint(confidence, sizeof confidence, "needs_recheck"); \
                snprint(suggested, sizeof suggested, "rerun with a focused gate or classify the timeout cause"); \
                snprint(reason, sizeof reason, "grid timeout"); \
            } \
        } while(0)
        #define WRITE_TRIAGE_ROW() do { \
            snprint(diff, sizeof diff, "task_id=%s worker_id=%s", taskid, worker); \
            fprint(ofd, "%s\t%s\t%s\t\t0\t0\t%s\t%s\t%s\t%s\t%s\n", \
                source, mutant, result, klass, confidence, suggested, reason, diff); \
            rows++; \
        } while(0)

        if(fromJournal){
            snprint(path, sizeof path, "%s/journal.log", r);
            fd = open(path, OREAD);
            if(fd >= 0){
                jbuf = malloc(262144);
                if(jbuf != nil){
                    rn = read(fd, jbuf, 262143);
                    if(rn < 0) rn = 0;
                    jbuf[rn] = '\0';
                    for(line = jbuf; line != nil && *line != '\0'; line = next){
                        next = strchr(line, '\n');
                        if(next != nil)
                            *next++ = '\0';
                        if(line[0] == '\0')
                            continue;
                        evdetail = "";
                        o9_journal_split(line, fields, 6, &evdetail);
                        if(strcmp(fields[3], "gate_exit") != 0 || strcmp(fields[4], "task") != 0)
                            continue;
                        taskid[0] = worker[0] = source[0] = mutant[0] = result[0] = '\0';
                        snprint(taskid, sizeof taskid, "%s", fields[5]);
                        snprint(worker, sizeof worker, "%s", fields[2]);
                        DETKEY(evdetail, "result", result, sizeof result);
                        if(strcmp(result, "survived") != 0 && strcmp(result, "timeout") != 0)
                            continue;
                        snprint(rpath, sizeof rpath, "%s/results/%s.tab", r, taskid);
                        o9_tsv_get_cols(rpath, dnames, douts, dsizes, 4);
                        if(taskid[0] == '\0')
                            snprint(taskid, sizeof taskid, "%s", fields[5]);
                        if(worker[0] == '\0')
                            snprint(worker, sizeof worker, "%s", fields[2]);
                        CLASSIFY_TRIAGE_ROW();
                        if(selected)
                            WRITE_TRIAGE_ROW();
                    }
                    free(jbuf);
                }
                close(fd);
            }
        } else {
            snprint(path, sizeof path, "%s/results", r);
            fd = open(path, OREAD);
            if(fd >= 0){
                dirs = nil;
                n = dirreadall(fd, &dirs);
                close(fd);
                for(i = 0; i < n; i++){
                    if((dirs[i].mode & DMDIR) != 0 || !o9_has_suffix(dirs[i].name, ".tab"))
                        continue;
                    taskid[0] = worker[0] = source[0] = mutant[0] = result[0] = '\0';
                    snprint(rpath, sizeof rpath, "%s/results/%s", r, dirs[i].name);
                    o9_tsv_get_cols(rpath, names, outs, sizes, 5);
                    if(strcmp(result, "survived") != 0 && strcmp(result, "timeout") != 0)
                        continue;
                    CLASSIFY_TRIAGE_ROW();
                    if(selected)
                        WRITE_TRIAGE_ROW();
                }
                free(dirs);
            }
        }

        if(includeMissing){
            snprint(path, sizeof path, "%s/tasks/done", r);
            fd = open(path, OREAD);
            if(fd >= 0){
                dirs = nil;
                n = dirreadall(fd, &dirs);
                close(fd);
                for(i = 0; i < n; i++){
                    int l;
                    if((dirs[i].mode & DMDIR) != 0 || !o9_has_suffix(dirs[i].name, ".tab"))
                        continue;
                    snprint(taskid, sizeof taskid, "%s", dirs[i].name);
                    l = strlen(taskid);
                    if(l > 4)
                        taskid[l - 4] = '\0';
                    snprint(rpath, sizeof rpath, "%s/results/%s.tab", r, taskid);
                    if(access(rpath, 0) == 0)
                        continue;
                    worker[0] = source[0] = mutant[0] = result[0] = '\0';
                    snprint(rpath, sizeof rpath, "%s/tasks/done/%s", r, dirs[i].name);
                    o9_tsv_get_cols(rpath, dnames, douts, dsizes, 4);
                    if(taskid[0] == '\0'){
                        snprint(taskid, sizeof taskid, "%s", dirs[i].name);
                        l = strlen(taskid);
                        if(l > 4)
                            taskid[l - 4] = '\0';
                    }
                    o9_strip_repo_prefix(source, rp);
                    result[0] = '\0';
                    snprint(klass, sizeof klass, "missing_report");
                    snprint(confidence, sizeof confidence, "missing");
                    snprint(suggested, sizeof suggested, "recover the result or rerun this task");
                    snprint(reason, sizeof reason, "result file missing");
                    WRITE_TRIAGE_ROW();
                }
                free(dirs);
            }
        }
        close(ofd);
        ofd = -1;
        snprint(triagemsg, sizeof triagemsg, "triage\t%s\nrows\t%d\n", outpath, rows);
        out = o9_string_from_c(triagemsg);
        tdone:
        #undef DETKEY
        #undef CLASSIFY_TRIAGE_ROW
        #undef WRITE_TRIAGE_ROW
        if(ofd >= 0)
            close(ofd);
        free(r); free(op); free(rp); free(ep);
    }
    return out;
}

function O9MutReportRaw(string root) string {
    string out;

    c {
        char *r;
        char path[1024];
        int fd;

        r = o9_string_cstr(root);
        if(r != nil){
            snprint(path, sizeof path, "%s/reports/latest.tab", r);
            fd = create(path, OWRITE, 0644);
            if(fd >= 0){
                fprint(fd, "status\tgenerated_at\nok\t%lld\n", (vlong)time(0));
                close(fd);
            }
        }
        out = o9_string_from_c("report\tgenerated\n");
        free(r);
    }
    return out;
}

function O9MutQueueWorkerRaw(string root, string worker, int64 idleMs, int64 maxPending) string {
    string out;

    c {
        char *r, *w, *buf, *line, *next, *fields[6], *s;
        char qdir[1024], qpath[1024], claimdir[1024], donepath[1024], taskpath[1024], workerpath[1024];
        char idbuf[256], qmsg[512], jpath[1024], detail[256];
        Dir *dirs, *st, *pdirs;
        int fd, n, rn, i, j, claimed, chunks, tasks, skipped, pending, pn, pi;
        vlong len;

        r = o9_string_cstr(root);
        w = o9_string_cstr(worker);
        chunks = tasks = skipped = 0;
        if(maxPending <= 0)
            maxPending = 512;
        if(idleMs <= 0)
            idleMs = 1000;
        if(r == nil || w == nil || r[0] == '\0' || w[0] == '\0'){
            out = o9_string_from_c("queue_worker setup_error: missing root or worker\n");
        } else {
            snprint(workerpath, sizeof workerpath, "%s/workers/%s.queue.tab", r, w);
            snprint(jpath, sizeof jpath, "%s/journal.log", r);
            o9_append_event(jpath, w, "worker_start", "worker", w, "");
            for(;;){
                fd = create(workerpath, OWRITE, 0644);
                if(fd >= 0){
                    fprint(fd, "worker_id\tpid\tlast_seen\tstatus\tchunks\ttasks\n");
                    fprint(fd, "%s\t%d\t%lld\tidle\t%d\t%d\n", w, getpid(), (vlong)time(0), chunks, tasks);
                    close(fd);
                }
                o9_append_event(jpath, w, "worker_heartbeat", "worker", w, "status=idle");
                snprint(qdir, sizeof qdir, "%s/queue/chunks/pending", r);
                fd = open(qdir, OREAD);
                if(fd < 0)
                    break;
                dirs = nil;
                n = dirreadall(fd, &dirs);
                close(fd);
                claimed = 0;
                for(i = 0; i < n && !claimed; i++){
	                    if(!o9_has_suffix(dirs[i].name, ".tab"))
	                        continue;
                    snprint(claimdir, sizeof claimdir, "%s/queue/chunks/claimed/%s", r, dirs[i].name);
                    fd = create(claimdir, OREAD, DMDIR|0755);
                    if(fd < 0)
                        continue;
                    close(fd);
                    claimed = 1;
                    o9_append_event(jpath, w, "chunk_claim", "chunk", dirs[i].name, "");
                    snprint(qpath, sizeof qpath, "%s/queue/chunks/pending/%s", r, dirs[i].name);
                    buf = nil;
                    st = dirstat(qpath);
                    if(st != nil){
                        len = st->length;
                        free(st);
                        fd = open(qpath, OREAD);
                        if(fd >= 0){
                            buf = malloc(len + 1);
                            if(buf != nil){
                                rn = read(fd, buf, len);
                                if(rn < 0) rn = 0;
                                buf[rn] = '\0';
                            }
                            close(fd);
                        }
                    }
                    /* chunk removed after done marker is written (Invariant 1) */
                    fd = create(workerpath, OWRITE, 0644);
                    if(fd >= 0){
                        fprint(fd, "worker_id\tpid\tlast_seen\tstatus\tchunks\ttasks\n");
                        fprint(fd, "%s\t%d\t%lld\trunning\t%d\t%d\n", w, getpid(), (vlong)time(0), chunks, tasks);
                        close(fd);
                    }
                    if(buf != nil){
                        for(line = buf; line != nil && *line != '\0'; line = next){
                            next = strchr(line, '\n');
                            if(next != nil)
                                *next++ = '\0';
                            if(line[0] == '\0')
                                continue;
                            for(j = 0; j < 6; j++) fields[j] = "";
                            fields[0] = line;
                            j = 1;
                            for(s = line; *s != '\0' && j < 6; s++){
                                if(*s == '\t'){
                                    *s = '\0';
                                    fields[j++] = s + 1;
                                } else if(*s == '\r') {
                                    *s = '\0';
                                    break;
                                }
                            }
                            if(j < 6 || fields[0][0] == '\0' || fields[3][0] == '\0'){
                                skipped++;
                                continue;
                            }
                            for(;;){
                                pending = 0;
                                snprint(taskpath, sizeof taskpath, "%s/tasks/pending", r);
                                fd = open(taskpath, OREAD);
                                if(fd >= 0){
                                    pdirs = nil;
                                    pn = dirreadall(fd, &pdirs);
                                    close(fd);
	                                    for(pi = 0; pi < pn; pi++)
	                                        if((pdirs[pi].mode & DMDIR) == 0 && o9_has_suffix(pdirs[pi].name, ".tab"))
	                                            pending++;
                                    free(pdirs);
                                }
                                if(pending < maxPending)
                                    break;
                                sleep(idleMs);
                            }
                            snprint(idbuf, sizeof idbuf, "%s", fields[0]);
                            for(s = idbuf; *s != '\0'; s++)
                                if(*s == '/' || *s == '\t' || *s == '\n' || *s == '\r')
                                    *s = '_';
                            snprint(taskpath, sizeof taskpath, "%s/tasks/pending/%s.tab", r, idbuf);
                            if(access(taskpath, 0) == 0){
                                skipped++;
                                continue;
                            }
                            fd = create(taskpath, OWRITE, 0644);
                            if(fd < 0){
                                skipped++;
                                continue;
                            }
                            fprint(fd, "task_id\tsource\tmutant_path\tgate\ttimeout_ms\tpriority\tattempt\tcreated_at\n");
                            fprint(fd, "%s\t%s\t%s\t%s\t%s\t%s\t0\t%lld\n",
                                idbuf, fields[1], fields[2], fields[3], fields[4], fields[5], (vlong)time(0));
                            close(fd);
                            snprint(detail, sizeof detail, "chunk=%s\tsource=%s\tmutant_path=%s\tgate=%s\ttimeout_ms=%s\tattempt=0", dirs[i].name, fields[1], fields[2], fields[3], fields[4]);
                            o9_append_event(jpath, w, "enqueue", "task", idbuf, detail);
                            tasks++;
                        }
                        free(buf);
                    }
                    snprint(donepath, sizeof donepath, "%s/queue/chunks/done/%s", r, dirs[i].name);
                    fd = create(donepath, OWRITE, 0644);
                    if(fd >= 0){
                        fprint(fd, "chunk\tworker_id\tfinished_at\n%s\t%s\t%lld\n", dirs[i].name, w, (vlong)time(0));
                        close(fd);
                    }
                    remove(qpath);
                    snprint(detail, sizeof detail, "worker=%s\ttasks=%d", w, tasks);
                    o9_append_event(jpath, w, "chunk_done", "chunk", dirs[i].name, detail);
                    remove(claimdir);
                    chunks++;
                }
                free(dirs);
                if(!claimed)
                    break;
            }
            o9_append_event(jpath, w, "worker_stop", "worker", w, "");
            snprint(qmsg, sizeof qmsg, "queue_worker\t%s\nchunks\t%d\ntasks\t%d\nskipped\t%d\n", w, chunks, tasks, skipped);
            out = o9_string_from_c(qmsg);
        }
        free(r); free(w);
    }
    return out;
}

function O9MutWorkerRaw(string root, string worker, int64 maxJobs, int64 idleMs) string {
    string out;

    c {
        char *r, *w, *tmpenv, *sysname;
        char pdir[1024], lockdir[1024], claimfile[1024], taskpath[1024], resultpath[1024], donepath[1024], workerpath[1024], drainpath[1024], cfgpath[1024];
        char logpath[1024], scratch[1024], buf[8192], jpath[1024], detail[256], *taskbuf, *row, *fields[8], *s;
        char *taskid, *source, *mutant, *gate, *timeouttxt, *attempt, *result;
        Dir *dirs, *st;
        int fd, n, rn, i, j, claimed, jobs, killed, survived, timeouts, setup, pid, timerpid, heartbeatpid, lfd, exitcode, timedout, childdone, timerdone, hbdone, heartbeatSec;
        vlong len, start, elapsed, timeoutms;
        Waitmsg *wm;

        r = o9_string_cstr(root);
        w = o9_string_cstr(worker);
        sysname = nil;
        jobs = killed = survived = timeouts = setup = 0;
        if(r == nil || w == nil || r[0] == '\0' || w[0] == '\0') {
            out = o9_string_from_c("worker setup_error: missing root or worker\n");
        } else {
            snprint(workerpath, sizeof workerpath, "%s/workers/%s.tab", r, w);
            snprint(drainpath, sizeof drainpath, "%s/workers/%s.drain", r, w);
            snprint(jpath, sizeof jpath, "%s/journal.log", r);
            snprint(cfgpath, sizeof cfgpath, "%s/config.tab", r);
            heartbeatSec = o9_kv_int(cfgpath, "heartbeat_sec", 30);
            if(heartbeatSec <= 0)
                heartbeatSec = 30;
            sysname = getenv("sysname");
            o9_append_event(jpath, w, "worker_start", "worker", w, "");
            for(;;){
            fd = create(workerpath, OWRITE, 0644);
            if(fd >= 0){
                fprint(fd, "worker_id\tnode\tpid\tstarted_at\tlast_seen\tstatus\tcurrent_task\n");
                fprint(fd, "%s\t%s\t%d\t%lld\t%lld\tidle\t\n", w, sysname != nil ? sysname : "", getpid(), (vlong)time(0), (vlong)time(0));
                close(fd);
            }
            if(access(drainpath, 0) == 0){
                o9_append_event(jpath, w, "worker_drain", "worker", w, "");
                break;
            }
            if(maxJobs > 0 && jobs >= maxJobs)
                break;
            snprint(pdir, sizeof pdir, "%s/tasks/pending", r);
            fd = open(pdir, OREAD);
            if(fd < 0)
                break;
            dirs = nil;
            n = dirreadall(fd, &dirs);
            close(fd);
            claimed = 0;
	            for(i = 0; i < n && !claimed; i++){
	                if((dirs[i].mode & DMDIR) != 0 || !o9_has_suffix(dirs[i].name, ".tab"))
	                    continue;
                taskid = strdup(dirs[i].name);
                if(taskid == nil)
                    continue;
                len = strlen(taskid);
                if(len > 4 && strcmp(taskid + len - 4, ".tab") == 0)
                    taskid[len - 4] = '\0';
                else {
                    free(taskid);
                    continue;
                }
                snprint(resultpath, sizeof resultpath, "%s/results/%s.tab", r, taskid);
                if(access(resultpath, 0) == 0){
                    free(taskid);
                    continue;
                }
                snprint(lockdir, sizeof lockdir, "%s/tasks/claimed/%s", r, taskid);
                fd = create(lockdir, OREAD, DMDIR|0755);
                if(fd < 0){
                    free(taskid);
                    continue;
                }
                close(fd);
                claimed = 1;
                o9_append_event(jpath, w, "task_claim", "task", taskid, "");
                snprint(claimfile, sizeof claimfile, "%s/claim.tab", lockdir);
                fd = create(claimfile, OWRITE, 0644);
                if(fd >= 0){
                    fprint(fd, "task_id\tworker_id\tclaimed_at\n%s\t%s\t%lld\n", taskid, w, (vlong)time(0));
                    close(fd);
                }
                snprint(taskpath, sizeof taskpath, "%s/tasks/pending/%s.tab", r, taskid);
                taskbuf = nil;
                st = dirstat(taskpath);
                if(st != nil){
                    len = st->length;
                    free(st);
                    fd = open(taskpath, OREAD);
                    if(fd >= 0){
                        taskbuf = malloc(len + 1);
                        if(taskbuf != nil){
                            rn = read(fd, taskbuf, len);
                            if(rn < 0) rn = 0;
                            taskbuf[rn] = '\0';
                        }
                        close(fd);
                    }
                }
                for(j = 0; j < 8; j++) fields[j] = "";
                if(taskbuf != nil){
                    row = strchr(taskbuf, '\n');
                    if(row != nil){
                        row++;
                        fields[0] = row;
                        j = 1;
                        for(s = row; *s != '\0' && j < 8; s++){
                            if(*s == '\t'){
                                *s = '\0';
                                fields[j++] = s + 1;
                            } else if(*s == '\n' || *s == '\r'){
                                *s = '\0';
                                break;
                            }
                        }
                    }
                }
                source = fields[1];
                mutant = fields[2];
                gate = fields[3];
                timeouttxt = fields[4];
                attempt = fields[6];
                timeoutms = strtoll(timeouttxt, nil, 0);
                if(timeoutms <= 0)
                    timeoutms = 300000;
	                snprint(logpath, sizeof logpath, "%s/logs/%s.%s.log", r, taskid, w);
	                tmpenv = getenv("O9MUT_TMP");
	                if(tmpenv == nil || tmpenv[0] == '\0'){
	                    if(tmpenv != nil)
	                        free(tmpenv);
	                    tmpenv = strdup("/tmp");
	                }
	                snprint(scratch, sizeof scratch, "%s/o9mut.%d.%s", tmpenv, getpid(), taskid);
	                fd = create(scratch, OREAD, DMDIR|0755);
	                if(fd >= 0) close(fd);
	                fd = create(workerpath, OWRITE, 0644);
	                if(fd >= 0){
	                    fprint(fd, "worker_id\tnode\tpid\tstarted_at\tlast_seen\tstatus\tcurrent_task\n");
	                    fprint(fd, "%s\t%s\t%d\t%lld\t%lld\trunning\t%s\n", w, sysname != nil ? sysname : "", getpid(), (vlong)time(0), (vlong)time(0), taskid);
	                    close(fd);
	                }
	                if(gate == nil || gate[0] == '\0'){
	                    fd = create(resultpath, OWRITE, 0644);
	                    if(fd >= 0){
                        fprint(fd, "task_id\tworker_id\tsource\tmutant_path\tresult\texit_code\tseconds\tlog_path\treason\tfinished_at\n");
                        fprint(fd, "%s\t%s\t%s\t%s\tsetup_error\t1\t0\t%s\tmissing gate\t%lld\n", taskid, w, source, mutant, logpath, (vlong)time(0));
                        close(fd);
		                    }
		                    snprint(detail, sizeof detail, "result=setup_error\texit_code=1\treason=missing_gate");
		                    o9_append_event(jpath, w, "gate_exit", "task", taskid, detail);
		                    o9_append_event(jpath, w, "task_done", "task", taskid, detail);
	                    snprint(donepath, sizeof donepath, "%s/tasks/done/%s.tab", r, taskid);
	                    fd = create(donepath, OWRITE, 0644);
	                    if(fd >= 0){
	                        fprint(fd, "task_id\tworker_id\tfinished_at\n%s\t%s\t%lld\n", taskid, w, (vlong)time(0));
	                        close(fd);
	                    }
	                    remove(taskpath);
	                    remove(claimfile);
	                    remove(lockdir);
	                    remove(scratch);
	                    setup++;
	                    jobs++;
	                    free(taskbuf);
	                    free(taskid);
	                    free(tmpenv);
                    continue;
                }
                start = nsec();
                snprint(detail, sizeof detail, "gate=%s\ttimeout_ms=%lld\tattempt=%s", gate, timeoutms, attempt);
                o9_append_event(jpath, w, "gate_start", "task", taskid, detail);
                pid = rfork(RFPROC|RFFDG|RFNOTEG);
                if(pid == 0){
                    lfd = create(logpath, OWRITE, 0644);
                    if(lfd >= 0){
                        dup(lfd, 1);
                        dup(lfd, 2);
                        close(lfd);
                    }
                    putenv("O9MUT_ROOT", r);
                    putenv("O9MUT_TASK_ID", taskid);
                    putenv("O9MUT_SOURCE", source);
                    putenv("O9MUT_MUTANT", mutant);
                    putenv("O9MUT_LOG", logpath);
                    putenv("O9MUT_SCRATCH", scratch);
                    putenv("O9MUT_ATTEMPT", attempt);
                    execl("/bin/rc", "rc", "-c", gate, nil);
                    exits("exec");
                }
                timerpid = rfork(RFPROC|RFFDG|RFNOTEG);
                if(timerpid == 0){
                    char note[64];
                    int nfd;
                    sleep(timeoutms);
                    snprint(note, sizeof note, "/proc/%d/notepg", pid);
                    nfd = open(note, OWRITE);
                    if(nfd >= 0){
                        write(nfd, "kill", 4);
                        close(nfd);
                    }
	                    exits(nil);
	                }
	                heartbeatpid = rfork(RFPROC|RFFDG|RFNOTEG);
	                if(heartbeatpid == 0){
	                    for(;;){
	                        sleep(heartbeatSec * 1000);
	                        fd = create(workerpath, OWRITE, 0644);
	                        if(fd >= 0){
	                            fprint(fd, "worker_id\tnode\tpid\tstarted_at\tlast_seen\tstatus\tcurrent_task\n");
	                            fprint(fd, "%s\t%s\t%d\t%lld\t%lld\trunning\t%s\n", w, sysname != nil ? sysname : "", getpid(), (vlong)time(0), (vlong)time(0), taskid);
	                            close(fd);
	                        }
	                        snprint(detail, sizeof detail, "status=running\ttask=%s", taskid);
	                        o9_append_event(jpath, w, "worker_heartbeat", "worker", w, detail);
	                    }
	                }
	                childdone = timerdone = hbdone = timedout = 0;
	                if(heartbeatpid < 0)
	                    hbdone = 1;
	                exitcode = 1;
	                while((wm = wait()) != nil){
	                    if(wm->pid == pid){
	                        if(wm->msg == nil || wm->msg[0] == '\0')
                            exitcode = 0;
                        else
                            exitcode = 1;
                        if(timeoutms > 0 && (nsec() - start) / 1000000LL >= timeoutms)
                            timedout = 1;
                        if(wm->msg != nil && strstr(wm->msg, "kill") != nil)
                            timedout = 1;
	                        childdone = 1;
	                    } else if(wm->pid == timerpid) {
	                        timerdone = 1;
	                    } else if(wm->pid == heartbeatpid) {
	                        hbdone = 1;
	                    }
	                    free(wm);
	                    if(childdone)
	                        break;
	                }
                if(!timerdone){
                    char note[64];
                    int nfd;
                    snprint(note, sizeof note, "/proc/%d/notepg", timerpid);
                    nfd = open(note, OWRITE);
                    if(nfd >= 0){
                        write(nfd, "kill", 4);
                        close(nfd);
                    }
                    while((wm = wait()) != nil){
                        if(wm->pid == timerpid){
                            free(wm);
                            break;
                        }
	                        free(wm);
	                    }
	                }
	                if(!hbdone){
	                    char note[64];
	                    int nfd;
	                    snprint(note, sizeof note, "/proc/%d/notepg", heartbeatpid);
	                    nfd = open(note, OWRITE);
	                    if(nfd >= 0){
	                        write(nfd, "kill", 4);
	                        close(nfd);
	                    }
	                    while((wm = wait()) != nil){
	                        if(wm->pid == heartbeatpid){
	                            free(wm);
	                            break;
	                        }
	                        free(wm);
	                    }
	                }
	                elapsed = (nsec() - start) / 1000000000LL;
	                result = "infra_fail";
                fd = create(resultpath, OWRITE, 0644);
                if(fd >= 0){
                    fprint(fd, "task_id\tworker_id\tsource\tmutant_path\tresult\texit_code\tseconds\tlog_path\treason\tfinished_at\n");
                    if(timedout){
                        fprint(fd, "%s\t%s\t%s\t%s\ttimeout\t1\t%lld\t%s\ttimeout_ms=%lld\t%lld\n", taskid, w, source, mutant, elapsed, logpath, timeoutms, (vlong)time(0));
                        result = "timeout";
                        timeouts++;
                    } else if(exitcode == 0){
                        fprint(fd, "%s\t%s\t%s\t%s\tsurvived\t0\t%lld\t%s\tgate passed\t%lld\n", taskid, w, source, mutant, elapsed, logpath, (vlong)time(0));
                        result = "survived";
                        survived++;
                    } else {
                        fprint(fd, "%s\t%s\t%s\t%s\tkilled\t%d\t%lld\t%s\tgate failed\t%lld\n", taskid, w, source, mutant, exitcode, elapsed, logpath, (vlong)time(0));
                        result = "killed";
                        killed++;
                    }
                    close(fd);
                }
	                if(timedout)
	                    snprint(detail, sizeof detail, "result=%s\texit_code=%d\tseconds=%lld\ttimeout_ms=%lld", result, exitcode, elapsed, timeoutms);
	                else
	                    snprint(detail, sizeof detail, "result=%s\texit_code=%d\tseconds=%lld", result, exitcode, elapsed);
                o9_append_event(jpath, w, "gate_exit", "task", taskid, detail);
                snprint(donepath, sizeof donepath, "%s/tasks/done/%s.tab", r, taskid);
                fd = create(donepath, OWRITE, 0644);
                if(fd >= 0){
                    fprint(fd, "task_id\tworker_id\tfinished_at\n%s\t%s\t%lld\n", taskid, w, (vlong)time(0));
                    close(fd);
                }
                snprint(detail, sizeof detail, "result=%s", result);
                o9_append_event(jpath, w, "task_done", "task", taskid, detail);
	                remove(taskpath);
	                remove(claimfile);
	                remove(lockdir);
	                remove(scratch);
	                jobs++;
	                free(taskbuf);
	                free(taskid);
                free(tmpenv);
            }
            free(dirs);
            if(!claimed){
                if(maxJobs > 0)
                    break;
                o9_append_event(jpath, w, "worker_heartbeat", "worker", w, "status=idle");
                sleep(idleMs > 0 ? idleMs : 1000);
            }
            }
	            o9_append_event(jpath, w, "worker_stop", "worker", w, "");
	            snprint(buf, sizeof buf, "worker\t%s\njobs\t%d\nkilled\t%d\nsurvived\t%d\ntimeout\t%d\nsetup_error\t%d\n", w, jobs, killed, survived, timeouts, setup);
	            out = o9_string_from_c(buf);
	        }
	        free(sysname);
	        free(r); free(w);
	    }
    return out;
}

function O9MutDaemonRaw(string root, int64 intervalMs, int64 staleSec, int64 cycles) string {
    string out;

    c {
        out = o9_string_from_c("o9mutd stopped\n");
    }
    return out;
}

function O9MutDaemonCycleRaw(string root, int64 cycle) int64 {
    int64 ok;

    c {
        char *r;
        char jpath[1024], detail[128];

        ok = 0;
        r = o9_string_cstr(root);
        if(r != nil && r[0] != '\0'){
            snprint(jpath, sizeof jpath, "%s/journal.log", r);
            snprint(detail, sizeof detail, "cycle=%lld", (vlong)cycle);
            o9_append_event(jpath, "daemon", "daemon_cycle", "root", r, detail);
            ok = 1;
        }
        free(r);
    }
    return ok;
}

/* Wait for the grid to drain: poll the four in-flight queues until every
 * one is empty. Returns "drained\n" once pending, claimed, chunks_pending,
 * and chunks_claimed are all zero; "timeout\t...\n" once timeoutMs has
 * elapsed (timeoutMs <= 0 means wait forever). The caller decides what a
 * timeout means — o9 has no exit statement, so the ctl tool surfaces a
 * non-zero status by inspecting this string rather than via a process exit. */
function O9MutWaitDrainRaw(string root, int64 timeoutMs, int64 intervalMs) string {
    string out;

    c {
	        char *r, *rf;
	        char ppath[1024], cpath[1024], cppath[1024], ccpath[1024], buf[256];
	        long pend, claim, cpend, cclaim;
	        vlong elapsed;

	        rf = o9_string_cstr(root);
	        r = rf;
	        if(r == nil || r[0] == '\0')
	            r = "/n/babyFileServer.rentonsoftworks.coin/o9mut";
        if(intervalMs <= 0)
            intervalMs = 1000;
        elapsed = 0;
        for(;;){
            snprint(ppath, sizeof ppath, "%s/tasks/pending", r);
            snprint(cpath, sizeof cpath, "%s/tasks/claimed", r);
            snprint(cppath, sizeof cppath, "%s/queue/chunks/pending", r);
            snprint(ccpath, sizeof ccpath, "%s/queue/chunks/claimed", r);
	            pend = o9_count_dir(ppath, 0, ".tab");
	            claim = o9_count_dir(cpath, 1, nil);
	            cpend = o9_count_dir(cppath, 0, ".tab");
	            cclaim = o9_count_dir(ccpath, 1, nil);
            if(pend == 0 && claim == 0 && cpend == 0 && cclaim == 0){
                out = o9_string_from_c("drained\n");
                goto wdone;
            }
            if(timeoutMs > 0 && elapsed >= timeoutMs){
                snprint(buf, sizeof buf, "timeout\tdrain timed out\tpending=%ld\tclaimed=%ld\tchunks_pending=%ld\tchunks_claimed=%ld\n", pend, claim, cpend, cclaim);
                out = o9_string_from_c(buf);
                goto wdone;
            }
            sleep((long)intervalMs);
            elapsed += intervalMs;
        }
	        wdone:
	        free(rf);
    }
    return out;
}

class O9Mut {
    method string defaultRoot() {
        Task<string> t = spawn O9MutDefaultRootRaw();
        return t.await();
    }

    method string defaultWorker() {
        Task<string> t = spawn O9MutDefaultWorkerRaw();
        return t.await();
    }

    method bool init(string root) {
        Task<int64> t = spawn O9MutInitRaw(root);
        return t.await() == 1;
    }

    method string enqueue(string root, string taskId, string source, string mutantPath, string gate, string timeoutMs, string priority) {
        Task<string> t = spawn O9MutEnqueueRaw(root, taskId, source, mutantPath, gate, timeoutMs, priority);
        return t.await();
    }

    method string enqueueManifest(string root, string manifest) {
        Task<string> t = spawn O9MutManifestRaw(root, manifest);
        return t.await();
    }

    method string status(string root) {
        Task<string> t = spawn O9MutStatusRaw(root, 0, 0, 0);
        return t.await();
    }

    method string statusEx(string root, int64 bySource, int64 workers, int64 fromJournal) {
        Task<string> t = spawn O9MutStatusRaw(root, bySource, workers, fromJournal);
        return t.await();
    }

    method string report(string root) {
        string text = status(root);
        writefile(cat(root, "/reports/latest.tab"), text);
        return text;
    }

    method string requeueStale(string root, int64 staleSec) {
        Task<string> t = spawn O9MutRequeueStaleRaw(root, staleSec);
        return t.await();
    }

    method string drainWorker(string root, string worker) {
        Task<string> t = spawn O9MutDrainWorkerRaw(root, worker);
        return t.await();
    }

    method string triage(string root, string output, int64 fromJournal, string repo, int64 classifyEquivalent, int64 classifyWhitespace, int64 includeMissing, string equivFile) {
        Task<string> t = spawn O9MutTriageRaw(root, output, fromJournal, repo, classifyEquivalent, classifyWhitespace, includeMissing, equivFile);
        return t.await();
    }

    method string runQueueWorker(string root, string worker, int64 idleMs, int64 maxPending) {
        Task<string> t = spawn O9MutQueueWorkerRaw(root, worker, idleMs, maxPending);
        return t.await();
    }

    method string runWorker(string root, string worker, int64 maxJobs, int64 idleMs) {
        Task<string> t = spawn O9MutWorkerRaw(root, worker, maxJobs, idleMs);
        return t.await();
    }

    method string runDaemon(string root, int64 intervalMs, int64 staleSec, int64 cycles) {
        Task<string> t = spawn O9MutDaemonRaw(root, intervalMs, staleSec, cycles);
        return t.await();
    }

    method bool daemonCycle(string root, int64 cycle) {
        Task<int64> t = spawn O9MutDaemonCycleRaw(root, cycle);
        return t.await() == 1;
    }

    method string waitDrain(string root, int64 timeoutMs, int64 intervalMs) {
        Task<string> t = spawn O9MutWaitDrainRaw(root, timeoutMs, intervalMs);
        return t.await();
    }
}
