import "appuser.o9";
import "process.o9";
import "time.o9";

main {
    print("BEGIN APPUSER\n");
    Task<string> modulusArg = spawn ProcessArgRaw(2);
    Task<string> exponentArg = spawn ProcessArgRaw(3);
    Task<string> wrongModulusArg = spawn ProcessArgRaw(4);
    Task<string> wrongExponentArg = spawn ProcessArgRaw(5);
    string modulus = modulusArg.await();
    string exponent = exponentArg.await();
    string wrongModulus = wrongModulusArg.await();
    string wrongExponent = wrongExponentArg.await();
    print("ARGS ", len(modulus), " ", len(exponent), " ", len(wrongModulus), " ", len(wrongExponent), "\n");
    string nonce = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef";
    AppUser alice = new AppUser("o9irc", "Alice", "alice", "alice@example.test", modulus, exponent);
    print("CREATED APPUSER\n");
    string profile = alice.profile();
    print("PROFILE ", len(profile) > 0, "\n");
    string signature = alice.prove("ircfs", nonce);
    print("SIGNED ", len(signature) > 0, "\n");
    print("VERIFY ", alice.verify("ircfs", nonce, signature), "\n");
    print("WRONG_SERVICE ", alice.verify("other", nonce, signature), "\n");
    print("WRONG_NONCE ", alice.verify("ircfs", "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", signature), "\n");
    AppUser otherApp = new AppUser("notes", "Alice", "alice", "", modulus, exponent);
    print("WRONG_APP ", otherApp.verify("ircfs", nonce, signature), "\n");
    AppUser notes = new AppUser("notes", "Alice", "alice", "", wrongModulus, wrongExponent);
    string notesSignature = notes.prove("ircfs", nonce);
    print("SECOND_APP_SIGNED ", len(notesSignature) > 0, "\n");
    print("SECOND_APP_VERIFY ", notes.verify("ircfs", nonce, notesSignature), "\n");
    AppUser wrongKey = new AppUser("o9irc", "Alice", "alice", "", wrongModulus, wrongExponent);
    print("WRONG_KEY ", wrongKey.verify("ircfs", nonce, signature), "\n");
    print("BAD_SCOPE ", len(alice.prove("bad scope", nonce)) == 0, "\n");

    AppUserRSAProvider provider = new AppUserRSAProvider("o9irc", "ircfs", 60);
    print("PROVIDER_ENROLL ", provider.enroll("alice", modulus, exponent), "\n");
    print("PROVIDER_DUP_KEY ", !provider.enroll("alias", modulus, exponent), "\n");
    print("PROVIDER_BAD_KEY ", !provider.enroll("badkey", "bad", exponent), "\n");
    AppUserRSAProvider invalidProvider = new AppUserRSAProvider("bad app", "ircfs", 60);
    print("PROVIDER_BAD_SCOPE ", !invalidProvider.enroll("alice", modulus, exponent), "\n");
    string challenge = provider.challenge("session1", "alice");
    print("PROVIDER_NONCE ", len(challenge) == 64, "\n");
    string answer = alice.prove("ircfs", challenge);
    print("PROVIDER_ANSWER ", cmp(provider.answer("session1", challenge, answer), "alice") == 0, "\n");
    print("PROVIDER_REPLAY ", len(provider.answer("session1", challenge, answer)) == 0, "\n");

    string prior = provider.challenge("session1", "alice");
    string replacement = provider.challenge("session1", "alice");
    print("PROVIDER_REPLACED ", len(provider.answer("session1", prior, alice.prove("ircfs", prior))) == 0, "\n");
    print("PROVIDER_REPLACED_CONSUMED ", len(provider.answer("session1", replacement, alice.prove("ircfs", replacement))) == 0, "\n");

    string another = provider.challenge("session2", "alice");
    string anotherAnswer = alice.prove("ircfs", another);
    print("PROVIDER_BINDING ", len(provider.answer("session3", another, anotherAnswer)) == 0, "\n");
    print("PROVIDER_BINDING_OK ", cmp(provider.answer("session2", another, anotherAnswer), "alice") == 0, "\n");

    string wrong = provider.challenge("session4", "alice");
    string wrongAnswer = notes.prove("ircfs", wrong);
    print("PROVIDER_BAD_SIG ", len(provider.answer("session4", wrong, wrongAnswer)) == 0, "\n");
    print("PROVIDER_BAD_RETRY ", len(provider.answer("session4", wrong, alice.prove("ircfs", wrong))) == 0, "\n");

    // Exercise the actual serialized .tab records through the filesystem.
    string challengeWire = provider.challengeTab("tab-session", "alice");
    writefile("/tmp/appuser-challenge.tab", challengeWire);
    tabula challengeRecord = new tabula("/tmp/appuser-challenge.tab");
    print("TAB_CHALLENGE ", cmp(challengeRecord.schema(), "appuser_challenge_v1") == 0 &&
          len(challengeRecord.value("challenge", "nonce")) == 64 &&
          len(challengeRecord.value("challenge", "deadline")) == 20, "\n");
    print("TAB_WRONG_SERVICE ", len(alice.responseTab(challengeRecord, "other")) == 0, "\n");
    string responseWire = alice.responseTab(challengeRecord, "ircfs");
    challengeRecord.close();
    writefile("/tmp/appuser-response.tab", responseWire);
    tabula responseRecord = new tabula("/tmp/appuser-response.tab");
    print("TAB_RESPONSE ", cmp(responseRecord.schema(), "appuser_response_v1") == 0 &&
          len(responseRecord.value("response", "signature")) == 512, "\n");
    print("TAB_WRONG_BINDING ", len(provider.answerTab("other-session", responseRecord)) == 0, "\n");
    print("TAB_ANSWER ", cmp(provider.answerTab("tab-session", responseRecord), "alice") == 0, "\n");
    print("TAB_REPLAY ", len(provider.answerTab("tab-session", responseRecord)) == 0, "\n");
    responseRecord.close();

    string wrongAppWire = provider.challengeTab("wrong-app-session", "alice");
    writefile("/tmp/appuser-wrong-app.tab", wrongAppWire);
    tabula wrongAppRecord = new tabula("/tmp/appuser-wrong-app.tab");
    print("TAB_WRONG_APP ", len(notes.responseTab(wrongAppRecord, "ircfs")) == 0, "\n");
    wrongAppRecord.close();

    AppUserRSAProvider shortProvider = new AppUserRSAProvider("o9irc", "ircfs", 1);
    shortProvider.enroll("alice", modulus, exponent);
    string expiring = shortProvider.challenge("session5", "alice");
    string expiringAnswer = alice.prove("ircfs", expiring);
    Task<int64> nap = spawn TimeSleepRaw(2500);
    nap.await();
    print("PROVIDER_EXPIRED ", len(shortProvider.answer("session5", expiring, expiringAnswer)) == 0, "\n");
}
