// Public application identity with stock 9front factotum RSA signing.
// The private key remains in factotum; an AppUser contains public data only.

internal function AppUserScopeValidRaw(string scope) bool {
    bool out;
    c {
        char *s;
        int i, n;

        out = 0;
        s = o9_string_data(scope);
        n = o9_string_len(scope);
        if(s != nil && n > 0 && n <= 64){
            out = 1;
            for(i = 0; i < n; i++)
                if(!((s[i] >= 'a' && s[i] <= 'z') ||
                     (s[i] >= 'A' && s[i] <= 'Z') ||
                     (s[i] >= '0' && s[i] <= '9') ||
                     s[i] == '.' || s[i] == '_' || s[i] == '-')){
                    out = 0;
                    break;
                }
        }
    }
    return out;
}

internal function AppUserNonceValidRaw(string nonce) bool {
    bool out;
    c {
        char *s;
        int i;

        out = 0;
        s = o9_string_data(nonce);
        if(s != nil && o9_string_len(nonce) == 64){
            out = 1;
            for(i = 0; i < 64; i++)
                if(!((s[i] >= '0' && s[i] <= '9') ||
                     (s[i] >= 'a' && s[i] <= 'f'))){
                    out = 0;
                    break;
                }
        }
    }
    return out;
}

// The version and field separators prevent one application's challenge from
// being interpreted as another application or service's challenge.
internal function AppUserChallenge(string app, string service, string nonce) string {
    Task<bool> appValid = spawn AppUserScopeValidRaw(app);
    Task<bool> serviceValid = spawn AppUserScopeValidRaw(service);
    Task<bool> nonceValid = spawn AppUserNonceValidRaw(nonce);
    if(!appValid.await() || !serviceValid.await() || !nonceValid.await()) {
        return "";
    }
    return cat(cat(cat(cat(cat("o9-appuser-rsa-sha256-v1\napp=", app),
        "\nservice="), service), "\nnonce="), cat(nonce, "\n"));
}

internal function AppUserRSASignRaw(string app, string message) string {
    use { auth sec }

    string out;
    c {
        static char digits[] = "0123456789abcdef";
        AuthRpc *rpc;
        char *name, *spec, *hex;
        uchar digest[SHA2_256dlen];
        int fd, i, n, appLen;
        char *appData;

        out = o9_string_from_c("");
        spec = nil;
        rpc = nil;
        fd = -1;
        appData = o9_string_data(app);
        appLen = o9_string_len(app);
        if(appData == nil || appLen < 1 || appLen > 64)
            goto sign_done;
        for(i = 0; i < appLen; i++)
            if(!((appData[i] >= 'a' && appData[i] <= 'z') ||
                 (appData[i] >= 'A' && appData[i] <= 'Z') ||
                 (appData[i] >= '0' && appData[i] <= '9') ||
                 appData[i] == '.' || appData[i] == '_' || appData[i] == '-'))
                goto sign_done;
        name = o9_string_cstr(app);
        if(name == nil)
            goto sign_done;
        spec = smprint("proto=rsa service=appuser app=%s hash=sha256 role=sign", name);
        free(name);
        if(spec == nil)
            goto sign_done;
        fd = open("/mnt/factotum/rpc", ORDWR|OCEXEC);
        if(fd < 0)
            goto sign_done;
        rpc = auth_allocrpc(fd);
        if(rpc == nil)
            goto sign_done;
        sha2_256((uchar*)o9_string_data(message), o9_string_len(message), digest, nil);
        if(auth_rpc(rpc, "start", spec, strlen(spec)) == ARok &&
           auth_rpc(rpc, "write", digest, sizeof digest) == ARok &&
           auth_rpc(rpc, "read", nil, 0) == ARok &&
           rpc->narg >= 256 && rpc->narg <= 1024){
            n = rpc->narg;
            hex = malloc(2*n+1);
            if(hex != nil){
                for(i = 0; i < n; i++){
                    hex[2*i] = digits[((uchar*)rpc->arg)[i] >> 4];
                    hex[2*i+1] = digits[((uchar*)rpc->arg)[i] & 15];
                }
                hex[2*n] = 0;
                o9_string_release(out);
                out = o9_string_take(hex);
            }
        }
        memset(digest, 0, sizeof digest);
sign_done:
        if(rpc != nil) auth_freerpc(rpc);
        if(fd >= 0) close(fd);
        free(spec);
    }
    return out;
}

// Verify the exact PKCS #1 v1.5 SHA-256 DigestInfo emitted by stock 9front
// factotum. Public key fields are the hex `n` and `ek` from auth/rsagen.
internal function AppUserRSAVerifyRaw(string modulus, string exponent,
                             string message, string signature) bool {
    use { sec mp }

    bool out;
    c {
        static uchar prefix[] = {
            0x30,0x31,0x30,0x0d,0x06,0x09,0x60,0x86,0x48,0x01,
            0x65,0x03,0x04,0x02,0x01,0x05,0x00,0x04,0x20
        };
        RSApub pub;
        mpint *sig, *plain;
        char *nhex, *ehex, *shex;
        uchar digest[SHA2_256dlen], *want, *got, *sigbytes;
        int i, k, m, len, hi, lo;

        out = 0;
        pub.n = nil;
        pub.ek = nil;
        sig = nil;
        plain = nil;
        want = nil;
        got = nil;
        sigbytes = nil;
        nhex = nil;
        ehex = nil;
        shex = nil;
        if(o9_string_len(modulus) < 512 || o9_string_len(modulus) > 2048 ||
           o9_string_len(exponent) < 1 || o9_string_len(exponent) > 8 ||
           o9_string_len(signature) < 512 || o9_string_len(signature) > 2048)
            goto verify_done;
        nhex = o9_string_cstr(modulus);
        ehex = o9_string_cstr(exponent);
        shex = o9_string_cstr(signature);
        if(nhex == nil || ehex == nil || shex == nil)
            goto verify_done;
        for(i = 0; nhex[i] != 0; i++)
            if(!((nhex[i] >= '0' && nhex[i] <= '9') ||
                 (nhex[i] >= 'a' && nhex[i] <= 'f') ||
                 (nhex[i] >= 'A' && nhex[i] <= 'F')))
                goto verify_done;
        for(i = 0; ehex[i] != 0; i++)
            if(!((ehex[i] >= '0' && ehex[i] <= '9') ||
                 (ehex[i] >= 'a' && ehex[i] <= 'f') ||
                 (ehex[i] >= 'A' && ehex[i] <= 'F')))
                goto verify_done;
        lo = nhex[strlen(nhex)-1];
        lo = lo >= '0' && lo <= '9' ? lo-'0' :
             lo >= 'a' && lo <= 'f' ? lo-'a'+10 : lo-'A'+10;
        if((lo & 1) == 0)
            goto verify_done;
        pub.n = strtomp(nhex, nil, 16, nil);
        pub.ek = strtomp(ehex, nil, 16, nil);
        if(pub.n == nil || pub.ek == nil ||
           mpsignif(pub.n) < 2048 || mpsignif(pub.n) > 8192 ||
           mpsignif(pub.ek) > 32 || mptoui(pub.ek) < 3 ||
           (mptoui(pub.ek) & 1) == 0)
            goto verify_done;
        k = (mpsignif(pub.n)+7)/8;
        len = strlen(shex);
        if(len != k*2)
            goto verify_done;
        sigbytes = malloc(k);
        want = malloc(k);
        got = malloc(k);
        if(sigbytes == nil || want == nil || got == nil)
            goto verify_done;
        for(i = 0; i < k; i++){
            hi = shex[2*i];
            lo = shex[2*i+1];
            hi = hi >= '0' && hi <= '9' ? hi-'0' :
                 hi >= 'a' && hi <= 'f' ? hi-'a'+10 : -1;
            lo = lo >= '0' && lo <= '9' ? lo-'0' :
                 lo >= 'a' && lo <= 'f' ? lo-'a'+10 : -1;
            if(hi < 0 || lo < 0)
                goto verify_done;
            sigbytes[i] = (hi << 4) | lo;
        }
        sig = betomp(sigbytes, k, nil);
        if(sig == nil || mpcmp(sig, pub.n) >= 0)
            goto verify_done;
        plain = rsaencrypt(&pub, sig, nil);
        if(plain == nil || mpsignif(plain) == 0 || mpsignif(plain) > k*8)
            goto verify_done;
        m = (mpsignif(plain)+7)/8;
        memset(got, 0, k);
        if(mptobe(plain, got+k-m, m, nil) != m)
            goto verify_done;
        sha2_256((uchar*)o9_string_data(message), o9_string_len(message), digest, nil);
        want[0] = 0;
        want[1] = 1;
        memset(want+2, 0xff, k-3-sizeof prefix-sizeof digest);
        want[k-1-sizeof prefix-sizeof digest] = 0;
        memmove(want+k-sizeof prefix-sizeof digest, prefix, sizeof prefix);
        memmove(want+k-sizeof digest, digest, sizeof digest);
        out = memcmp(got, want, k) == 0;
verify_done:
        memset(digest, 0, sizeof digest);
        free(nhex);
        free(ehex);
        free(shex);
        free(sigbytes);
        free(want);
        free(got);
        if(sig != nil) mpfree(sig);
        if(plain != nil) mpfree(plain);
        if(pub.n != nil) mpfree(pub.n);
        if(pub.ek != nil) mpfree(pub.ek);
    }
    return out;
}

internal function AppUserRSAKeyValidRaw(string modulus, string exponent) bool {
    use { mp }

    bool out;
    c {
        mpint *n, *e;
        char *nh, *eh;
        int i, digit;

        out = 0;
        n = nil;
        e = nil;
        nh = nil;
        eh = nil;
        if(o9_string_len(modulus) < 512 || o9_string_len(modulus) > 2048 ||
           o9_string_len(exponent) < 1 || o9_string_len(exponent) > 8)
            goto key_done;
        nh = o9_string_cstr(modulus);
        eh = o9_string_cstr(exponent);
        if(nh == nil || eh == nil)
            goto key_done;
        for(i = 0; nh[i] != 0; i++)
            if(!((nh[i] >= '0' && nh[i] <= '9') ||
                 (nh[i] >= 'a' && nh[i] <= 'f') ||
                 (nh[i] >= 'A' && nh[i] <= 'F')))
                goto key_done;
        for(i = 0; eh[i] != 0; i++)
            if(!((eh[i] >= '0' && eh[i] <= '9') ||
                 (eh[i] >= 'a' && eh[i] <= 'f') ||
                 (eh[i] >= 'A' && eh[i] <= 'F')))
                goto key_done;
        digit = nh[strlen(nh)-1];
        digit = digit >= '0' && digit <= '9' ? digit-'0' :
                digit >= 'a' && digit <= 'f' ? digit-'a'+10 : digit-'A'+10;
        if((digit & 1) == 0)
            goto key_done;
        n = strtomp(nh, nil, 16, nil);
        e = strtomp(eh, nil, 16, nil);
        out = n != nil && e != nil &&
              mpsignif(n) >= 2048 && mpsignif(n) <= 8192 &&
              mpsignif(e) <= 32 && mptoui(e) >= 3 && (mptoui(e) & 1) != 0;
key_done:
        free(nh);
        free(eh);
        if(n != nil) mpfree(n);
        if(e != nil) mpfree(e);
    }
    return out;
}

class AppUser {
    private string appValue;
    private string nameValue;
    private string aliasValue;
    private string emailValue;
    private string modulusValue;
    private string exponentValue;

    method AppUser(string app, string name, string alias, string email,
                   string modulus, string exponent) {
        appValue = app;
        nameValue = name;
        aliasValue = alias;
        emailValue = email;
        modulusValue = modulus;
        exponentValue = exponent;
    }

    method string profile() {
        tabula t = new tabula("app_user", "app,algorithm,name,alias,email,modulus,exponent");
        t.write("user", "app", appValue);
        t.write("user", "algorithm", "rsa-pkcs1v15-sha256");
        t.write("user", "name", nameValue);
        t.write("user", "alias", aliasValue);
        t.write("user", "email", emailValue);
        t.write("user", "modulus", modulusValue);
        t.write("user", "exponent", exponentValue);
        string data = t.read();
        t.close();
        return data;
    }

    internal method string prove(string service, string nonce) {
        Task<string> challenge = spawn AppUserChallenge(appValue, service, nonce);
        string message = challenge.await();
        if(len(message) == 0) {
            return "";
        }
        Task<string> signature = spawn AppUserRSASignRaw(appValue, message);
        return signature.await();
    }

    method bool verify(string service, string nonce, string signature) {
        Task<string> challenge = spawn AppUserChallenge(appValue, service, nonce);
        string message = challenge.await();
        if(len(message) == 0) {
            return false;
        }
        Task<bool> result = spawn AppUserRSAVerifyRaw(modulusValue, exponentValue, message, signature);
        return result.await();
    }
}

// Application code calls these internal methods from its 9P request handler.
// The binding must be a server-generated connection/session ID, never a
// client-supplied username. A successful answer returns the enrolled principal.
interface AppUserAuthProvider {
    internal method string challenge(string binding, string principal);
    internal method string answer(string binding, string nonce, string signature);
}

// Fixed-width decimal timestamps keep expiry comparisons lexical and bounded.
internal function AppUserStampRaw(int64 offset) string {
    string out;
    c {
        char buf[32];
        vlong deadline;

        if(offset < 0 || offset > 300){
            out = o9_string_from_c("");
        }else{
            deadline = (vlong)time(0) + offset;
            snprint(buf, sizeof buf, "%020lld", deadline);
            out = o9_string_from_c(buf);
        }
    }
    return out;
}

class AppUserRSAProvider {
    AppUserAuthProvider;

    private string appValue;
    private string serviceValue;
    private bool scopesValid;
    private int64 ttlValue;
    private int64 keyCount;
    private int64 pendingCount;
    private tabula keys;
    private tabula pending;

    method AppUserRSAProvider(string app, string service, int64 ttlSeconds) {
        appValue = app;
        serviceValue = service;
        Task<bool> appValid = spawn AppUserScopeValidRaw(app);
        Task<bool> serviceValid = spawn AppUserScopeValidRaw(service);
        bool appOk = appValid.await();
        bool serviceOk = serviceValid.await();
        scopesValid = appOk && serviceOk;
        ttlValue = ttlSeconds;
        if(ttlValue < 1 || ttlValue > 300) {
            ttlValue = 60;
        }
        keyCount = 0;
        pendingCount = 0;
        keys = new tabula("app_user_keys", "modulus,exponent");
        pending = new tabula("app_user_pending", "principal,nonce,deadline");
    }

    // Only the serving application may enroll a previously trusted key.
    internal method bool enroll(string principal, string modulus, string exponent) {
        if(!scopesValid) {
            return false;
        }
        Task<bool> valid = spawn AppUserScopeValidRaw(principal);
        Task<bool> keyValid = spawn AppUserRSAKeyValidRaw(modulus, exponent);
        bool principalOk = valid.await();
        bool keyOk = keyValid.await();
        if(!principalOk || !keyOk) {
            return false;
        }
        bool duplicate = false;
        int64 more = keys.first();
        while(more != 0) {
            if(cmp(keys.get("id"), principal) != 0 &&
               cmp(keys.get("modulus"), modulus) == 0 &&
               cmp(keys.get("exponent"), exponent) == 0) {
                duplicate = true;
            }
            more = keys.next();
        }
        if(duplicate) {
            return false;
        }
        bool fresh = len(keys.value(principal, "modulus")) == 0;
        if(fresh && keyCount >= 64) {
            return false;
        }
        if(keys.write(principal, "modulus", modulus) != 0 ||
           keys.write(principal, "exponent", exponent) != 0) {
            if(fresh) {
                keys.remove(principal);
            }
            return false;
        }
        if(fresh) {
            keyCount = keyCount + 1;
        }
        return true;
    }

    // The returned nonce is sent to the supplicant. The server keeps its
    // binding and principal private until the response is verified.
    internal method string challenge(string binding, string principal) {
        Task<bool> valid = spawn AppUserScopeValidRaw(binding);
        if(!valid.await() || len(keys.value(principal, "modulus")) == 0) {
            return "";
        }
        string nonce = keygen();
        if(len(nonce) != 64) {
            return "";
        }
        Task<string> deadlineTask = spawn AppUserStampRaw(ttlValue);
        string deadline = deadlineTask.await();
        if(len(deadline) != 20) {
            return "";
        }
        if(len(pending.value(binding, "nonce")) > 0) {
            if(pending.remove(binding) != 0) {
                return "";
            }
            pendingCount = pendingCount - 1;
        }
        if(pendingCount >= 128) {
            Task<string> nowTask = spawn AppUserStampRaw(0);
            string now = nowTask.await();
            string expired = "";
            int64 more = pending.first();
            while(more != 0) {
                if(len(expired) == 0 && cmp(pending.get("deadline"), now) < 0) {
                    expired = pending.get("id");
                }
                more = pending.next();
            }
            if(len(expired) == 0 || pending.remove(expired) != 0) {
                return "";
            }
            pendingCount = pendingCount - 1;
        }
        if(pending.write(binding, "principal", principal) != 0 ||
           pending.write(binding, "nonce", nonce) != 0 ||
           pending.write(binding, "deadline", deadline) != 0) {
            pending.remove(binding);
            return "";
        }
        pendingCount = pendingCount + 1;
        return nonce;
    }

    // Consumes the challenge before checking the signature. Each binding can
    // have one outstanding challenge, and expiry is checked at completion.
    internal method string answer(string binding, string nonce, string signature) {
        string expected = pending.value(binding, "nonce");
        if(len(expected) == 0) {
            return "";
        }
        string principal = pending.value(binding, "principal");
        string deadline = pending.value(binding, "deadline");
        pending.remove(binding);
        pendingCount = pendingCount - 1;
        Task<string> nowTask = spawn AppUserStampRaw(0);
        string now = nowTask.await();
        if(cmp(now, deadline) > 0 || cmp(nonce, expected) != 0) {
            return "";
        }
        string modulus = keys.value(principal, "modulus");
        string exponent = keys.value(principal, "exponent");
        if(len(modulus) == 0 || len(exponent) == 0) {
            return "";
        }
        Task<string> challengeTask = spawn AppUserChallenge(appValue, serviceValue, nonce);
        string message = challengeTask.await();
        if(len(message) == 0) {
            return "";
        }
        Task<bool> verified = spawn AppUserRSAVerifyRaw(modulus, exponent, message, signature);
        if(!verified.await()) {
            return "";
        }
        return principal;
    }

    ~AppUserRSAProvider() {
        keys.close();
        pending.close();
    }
}
