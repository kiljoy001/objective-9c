import "bytes.o9";

function IOReadAllRaw(string path) string {
    use { bio }

    string out;
    c {
        Biobuf *b;
        char *cpath, *buf, *nb;
        long n, total, cap;

        out = o9_string_new("", 0);
        cpath = o9_string_cstr(path);
        b = cpath != nil ? Bopen(cpath, OREAD) : nil;
        free(cpath);
        if(b != nil){
            cap = 8192;
            total = 0;
            buf = malloc(cap);
            if(buf != nil){
                while((n = Bread(b, buf + total, cap - total)) > 0){
                    total += n;
                    if(total >= cap){
                        cap *= 2;
                        nb = realloc(buf, cap);
                        if(nb == nil)
                            break;
                        buf = nb;
                    }
                }
                out = o9_string_new(buf, total);
                free(buf);
            }
            Bterm(b);
        }
    }
    return out;
}

function IOReadLineRaw(string path, int64 offset) string {
    use { bio }

    string out;
    c {
        Biobuf *b;
        char *cpath, *buf, *nb;
        long total, cap;
        int ch;

        out = o9_string_new("", 0);
        cpath = o9_string_cstr(path);
        b = cpath != nil ? Bopen(cpath, OREAD) : nil;
        free(cpath);
        if(b != nil){
            if(offset < 0)
                offset = 0;
            Bseek(b, offset, 0);
            cap = 128;
            total = 0;
            buf = malloc(cap);
            if(buf != nil){
                while((ch = Bgetc(b)) >= 0){
                    if(ch == '\n')
                        break;
                    if(total >= cap){
                        cap *= 2;
                        nb = realloc(buf, cap);
                        if(nb == nil)
                            break;
                        buf = nb;
                    }
                    buf[total++] = ch;
                }
                out = o9_string_new(buf, total);
                free(buf);
            }
            Bterm(b);
        }
    }
    return out;
}

function IOLineNextRaw(string path, int64 offset) int64 {
    use { bio }

    int64 out;
    c {
        Biobuf *b;
        char *cpath;
        int ch;

        out = offset;
        cpath = o9_string_cstr(path);
        b = cpath != nil ? Bopen(cpath, OREAD) : nil;
        free(cpath);
        if(b != nil){
            if(offset < 0)
                offset = 0;
            Bseek(b, offset, 0);
            while((ch = Bgetc(b)) >= 0){
                out++;
                if(ch == '\n')
                    break;
            }
            Bterm(b);
        }
    }
    return out;
}

function IOHasByteRaw(string path, int64 offset) int64 {
    use { bio }

    int64 out;
    c {
        Biobuf *b;
        char *cpath;
        int ch;

        out = 0;
        cpath = o9_string_cstr(path);
        b = cpath != nil ? Bopen(cpath, OREAD) : nil;
        free(cpath);
        if(b != nil){
            if(offset < 0)
                offset = 0;
            Bseek(b, offset, 0);
            ch = Bgetc(b);
            if(ch >= 0)
                out = 1;
            Bterm(b);
        }
    }
    return out;
}

function IOReadByteRaw(string path, int64 offset) byte {
    use { bio }

    byte out;
    c {
        Biobuf *b;
        char *cpath;
        int ch;

        out = 0;
        cpath = o9_string_cstr(path);
        b = cpath != nil ? Bopen(cpath, OREAD) : nil;
        free(cpath);
        if(b != nil){
            if(offset < 0)
                offset = 0;
            Bseek(b, offset, 0);
            ch = Bgetc(b);
            if(ch >= 0)
                out = (uchar)ch;
            Bterm(b);
        }
    }
    return out;
}

function IOWriteRaw(string path, string data, int64 mode) int64 {
    use { bio }

    int64 out;
    c {
        Biobuf *b;
        char *cpath;
        int fd;
        vlong n;

        out = -1;
        cpath = o9_string_cstr(path);
        if(cpath != nil){
            if(mode == 0)
                fd = create(cpath, OWRITE, 0644);
            else {
                fd = open(cpath, OWRITE);
                if(fd < 0)
                    fd = create(cpath, OWRITE, 0644);
                else
                    seek(fd, 0, 2);
            }
            free(cpath);
            if(fd >= 0){
                b = Bfdopen(fd, OWRITE);
                if(b != nil){
                    n = o9_string_len(data);
                    if(Bwrite(b, o9_string_data(data), n) == n && Bflush(b) >= 0)
                        out = n;
                    Bterm(b);
                } else
                    close(fd);
            }
        }
    }
    return out;
}

function IOTruncateRaw(string path) int64 {
    int64 out;
    c {
        char *cpath;
        int fd;

        out = -1;
        cpath = o9_string_cstr(path);
        if(cpath != nil){
            fd = create(cpath, OWRITE, 0644);
            free(cpath);
            if(fd >= 0){
                close(fd);
                out = 0;
            }
        }
    }
    return out;
}

function IOByteStringRaw(byte b) string {
    string out;
    c {
        uchar c;

        c = (uchar)b;
        out = o9_string_new((char*)&c, 1);
    }
    return out;
}

/* ---- Stream raws: a single buffered Biobuf held open across calls ---- */

function O9StreamOpenRaw(string path, string mode) int64 {
    use { bio }

    int64 out;
    c {
        Biobuf *b;
        char *cpath, *cmode;
        int fd;

        b = nil;
        cpath = o9_string_cstr(path);
        cmode = o9_string_cstr(mode);
        if(cpath != nil && cmode != nil){
            if(cmode[0] == 'r')
                b = Bopen(cpath, OREAD);
            else if(cmode[0] == 'w'){
                fd = create(cpath, OWRITE, 0644);
                if(fd >= 0){
                    b = Bfdopen(fd, OWRITE);
                    if(b == nil)
                        close(fd);
                }
            } else if(cmode[0] == 'a'){
                fd = open(cpath, OWRITE);
                if(fd < 0)
                    fd = create(cpath, OWRITE, 0644);
                if(fd >= 0){
                    seek(fd, 0, 2);
                    b = Bfdopen(fd, OWRITE);
                    if(b == nil)
                        close(fd);
                }
            }
        }
        free(cpath);
        free(cmode);
        out = (vlong)(uintptr)b;
    }
    return out;
}

function O9StreamReadRaw(int64 h, int64 n) string {
    use { bio }

    string out;
    c {
        Biobuf *b;
        char *buf;
        long want, nr;

        out = o9_string_new("", 0);
        b = (Biobuf*)(uintptr)h;
        want = (long)n;
        if(b != nil && want > 0){
            buf = malloc(want);
            if(buf != nil){
                nr = Bread(b, buf, want);
                if(nr > 0)
                    out = o9_string_new(buf, nr);
                free(buf);
            }
        }
    }
    return out;
}

function O9StreamWriteRaw(int64 h, string data) int64 {
    use { bio }

    int64 out;
    c {
        Biobuf *b;
        vlong n;
        long w;

        out = -1;
        b = (Biobuf*)(uintptr)h;
        if(b != nil){
            n = o9_string_len(data);
            w = Bwrite(b, o9_string_data(data), (long)n);
            out = (vlong)w;
        }
    }
    return out;
}

function O9StreamFlushRaw(int64 h) int64 {
    use { bio }

    int64 out;
    c {
        Biobuf *b;

        out = -1;
        b = (Biobuf*)(uintptr)h;
        if(b != nil)
            out = Bflush(b);
    }
    return out;
}

function O9StreamPositionRaw(int64 h) int64 {
    use { bio }

    int64 out;
    c {
        Biobuf *b;

        out = -1;
        b = (Biobuf*)(uintptr)h;
        if(b != nil)
            out = Boffset(b);
    }
    return out;
}

function O9StreamSeekRaw(int64 h, int64 pos) int64 {
    use { bio }

    int64 out;
    c {
        Biobuf *b;

        out = -1;
        b = (Biobuf*)(uintptr)h;
        if(b != nil)
            out = Bseek(b, pos, 0);
    }
    return out;
}

function O9StreamEofRaw(int64 h) int64 {
    use { bio }

    int64 out;
    c {
        Biobuf *b;
        int ch;

        out = 1;
        b = (Biobuf*)(uintptr)h;
        if(b != nil){
            ch = Bgetc(b);
            if(ch >= 0){
                Bungetc(b);
                out = 0;
            }
        }
    }
    return out;
}

function O9StreamCloseRaw(int64 h) int64 {
    use { bio }

    int64 out;
    c {
        Biobuf *b;

        out = -1;
        b = (Biobuf*)(uintptr)h;
        if(b != nil)
            out = Bterm(b);
    }
    return out;
}

class IOBuffer {
    private string path;
    private int64 offset;
    private int64 appendMode;
    private int64 writeStarted;
    private int64 closed;

    method IOBuffer(string p) {
        path = p;
        offset = 0;
        appendMode = 1;
        writeStarted = 0;
        closed = 0;
    }

    method string file() {
        return path;
    }

    method int64 position() {
        return offset;
    }

    method void seek(int64 pos) {
        if(pos < 0) {
            offset = 0;
        } else {
            offset = pos;
        }
    }

    method void reset() {
        offset = 0;
    }

    method void appendWrites() {
        appendMode = 1;
    }

    method int64 truncate() {
        Task<int64> t = spawn IOTruncateRaw(path);
        appendMode = 0;
        writeStarted = 0;
        return t.await();
    }

    method string readAll() {
        Task<string> t = spawn IOReadAllRaw(path);
        return t.await();
    }

    method bool eof() {
        Task<int64> t = spawn IOHasByteRaw(path, offset);
        return t.await() == 0;
    }

    method string readLine() {
        Task<string> t = spawn IOReadLineRaw(path, offset);
        string line = t.await();
        Task<int64> n = spawn IOLineNextRaw(path, offset);
        offset = n.await();
        return line;
    }

    method byte readByte() {
        Task<byte> t = spawn IOReadByteRaw(path, offset);
        byte b = t.await();
        Task<int64> h = spawn IOHasByteRaw(path, offset);
        if(h.await() == 1) {
            offset = offset + 1;
        }
        return b;
    }

    method int64 write(string data) {
        int64 mode = 1;
        if(closed == 1) {
            return -1;
        }
        if(writeStarted == 0 && appendMode == 0) {
            mode = 0;
        }
        Task<int64> t = spawn IOWriteRaw(path, data, mode);
        writeStarted = 1;
        return t.await();
    }

    method int64 writeBytes(Bytes data) {
        return write(data.text());
    }

    method int64 writeByte(byte b) {
        Task<string> t = spawn IOByteStringRaw(b);
        return write(t.await());
    }

    method int64 flush() {
        return 0;
    }

    method void close() {
        closed = 1;
    }
}

class Reader {
    private string path;
    private int64 offset;
    private int64 closed;

    method Reader(string p) {
        path = p;
        offset = 0;
        closed = 0;
    }

    method string readAll() {
        Task<string> t = spawn IOReadAllRaw(path);
        return t.await();
    }

    method string readLine() {
        Task<string> t = spawn IOReadLineRaw(path, offset);
        string line = t.await();
        Task<int64> n = spawn IOLineNextRaw(path, offset);
        offset = n.await();
        return line;
    }

    method byte readByte() {
        Task<byte> t = spawn IOReadByteRaw(path, offset);
        byte b = t.await();
        Task<int64> h = spawn IOHasByteRaw(path, offset);
        if(h.await() == 1) {
            offset = offset + 1;
        }
        return b;
    }

    method bool eof() {
        Task<int64> t = spawn IOHasByteRaw(path, offset);
        return t.await() == 0;
    }

    method void seek(int64 pos) {
        if(pos < 0) {
            offset = 0;
        } else {
            offset = pos;
        }
    }

    method void reset() {
        offset = 0;
    }

    method int64 position() {
        return offset;
    }

    method void close() {
        closed = 1;
    }
}

class Writer {
    private string path;
    private int64 writeStarted;
    private int64 closed;

    method Writer(string p) {
        path = p;
        writeStarted = 0;
        closed = 0;
        Task<int64> t = spawn IOTruncateRaw(path);
        t.await();
    }

    method int64 write(string data) {
        int64 mode = 1;
        if(closed == 1) {
            return -1;
        }
        if(writeStarted == 0) {
            mode = 0;
        }
        Task<int64> t = spawn IOWriteRaw(path, data, mode);
        writeStarted = 1;
        return t.await();
    }

    method int64 writeBytes(Bytes data) {
        return write(data.text());
    }

    method int64 writeByte(byte b) {
        Task<string> t = spawn IOByteStringRaw(b);
        return write(t.await());
    }

    method int64 flush() {
        return 0;
    }

    method void close() {
        closed = 1;
    }
}

class Appender {
    private string path;
    private int64 closed;

    method Appender(string p) {
        path = p;
        closed = 0;
    }

    method int64 write(string data) {
        if(closed == 1) {
            return -1;
        }
        Task<int64> t = spawn IOWriteRaw(path, data, 1);
        return t.await();
    }

    method int64 writeBytes(Bytes data) {
        return write(data.text());
    }

    method int64 writeByte(byte b) {
        Task<string> t = spawn IOByteStringRaw(b);
        return write(t.await());
    }

    method int64 flush() {
        return 0;
    }

    method void close() {
        closed = 1;
    }
}

/* Byte-oriented data streams backed by a single libbio Biobuf that stays
 * open for the life of the object (unlike Reader/Writer/Appender, which
 * reopen the file per call).  StreamReader/StreamWriter are the byte analogs
 * of the C# text adapters: no line methods, just raw bytes via o9's
 * binary-safe string.  The Biobuf* lives in C heap (Bopen/Bfdopen alloc,
 * Bterm frees) and is carried between calls as a private int64 handle; every
 * method spawns the matching raw, which casts the handle back to Biobuf*. */
class StreamReader {
    private int64 h;
    private int64 closed;

    method StreamReader(string path) {
        Task<int64> t = spawn O9StreamOpenRaw(path, "r");
        h = t.await();
        closed = 0;
    }

    method string read(int64 n) {
        if(closed == 1) {
            return "";
        }
        Task<string> t = spawn O9StreamReadRaw(h, n);
        return t.await();
    }

    method int64 position() {
        Task<int64> t = spawn O9StreamPositionRaw(h);
        return t.await();
    }

    method void seek(int64 pos) {
        if(pos < 0) {
            pos = 0;
        }
        Task<int64> t = spawn O9StreamSeekRaw(h, pos);
        t.await();
    }

    method bool endOfStream() {
        Task<int64> t = spawn O9StreamEofRaw(h);
        return t.await() == 1;
    }

    method void close() {
        if(closed == 0 && h != 0) {
            Task<int64> t = spawn O9StreamCloseRaw(h);
            t.await();
            h = 0;
        }
        closed = 1;
    }
}

class StreamWriter {
    private int64 h;
    private int64 closed;

    method StreamWriter(string path, string mode) {
        Task<int64> t = spawn O9StreamOpenRaw(path, mode);
        h = t.await();
        closed = 0;
    }

    method int64 write(string data) {
        if(closed == 1) {
            return -1;
        }
        Task<int64> t = spawn O9StreamWriteRaw(h, data);
        return t.await();
    }

    method int64 writeBytes(Bytes data) {
        return write(data.text());
    }

    method int64 flush() {
        Task<int64> t = spawn O9StreamFlushRaw(h);
        return t.await();
    }

    method int64 position() {
        Task<int64> t = spawn O9StreamPositionRaw(h);
        return t.await();
    }

    method void close() {
        if(closed == 0 && h != 0) {
            Task<int64> t = spawn O9StreamCloseRaw(h);
            t.await();
            h = 0;
        }
        closed = 1;
    }
}
