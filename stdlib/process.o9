import "buffer.o9";
import "collections.o9";

function ProcessArgcRaw() int64 {
    int64 out;
    c {
        out = o9_process_argc();
    }
    return out;
}

function ProcessArgRaw(int64 index) string {
    string out;
    c {
        out = o9_process_arg(index);
    }
    return out;
}

function ProcessPidRaw() int64 {
    int64 out;
    c {
        out = getpid();
    }
    return out;
}

function ProcessUserRaw() string {
    string out;
    c {
        char *u;

        u = getuser();
        out = o9_string_from_c(u != nil ? u : "");
    }
    return out;
}

function ProcessRunRaw(string command) int64 {
    int64 out;
    c {
        char *cmd;
        int pid;
        Waitmsg *w;

        out = -1;
        cmd = o9_string_cstr(command);
        if(cmd != nil){
            pid = rfork(RFPROC|RFFDG|RFNOTEG);
            if(pid == 0){
                execl("/bin/rc", "rc", "-c", cmd, nil);
                exits("exec");
            }
            if(pid > 0){
                for(;;){
                    w = wait();
                    if(w == nil)
                        break;
                    if(w->pid == pid){
                        out = (w->msg == nil || w->msg[0] == '\0') ? 0 : 1;
                        free(w);
                        break;
                    }
                    free(w);
                }
            }
            free(cmd);
        }
    }
    return out;
}

function ProcessOutputRaw(string command) string {
    string out;
    c {
        char *cmd, *buf, *next;
        int p[2], pid, n;
        vlong len, cap;
        Waitmsg *w;

        out = o9_string_new("", 0);
        cmd = o9_string_cstr(command);
        if(cmd != nil){
            if(pipe(p) == 0){
                pid = rfork(RFPROC|RFFDG|RFNOTEG);
                if(pid == 0){
                    close(p[0]);
                    dup(p[1], 1);
                    dup(p[1], 2);
                    close(p[1]);
                    execl("/bin/rc", "rc", "-c", cmd, nil);
                    exits("exec");
                }
                close(p[1]);
                cap = 1024;
                len = 0;
                buf = malloc(cap);
                if(buf != nil){
                    while((n = read(p[0], buf + len, cap - len)) > 0){
                        len += n;
                        if(cap - len < 512){
                            cap *= 2;
                            next = realloc(buf, cap);
                            if(next == nil)
                                break;
                            buf = next;
                        }
                    }
                    out = o9_string_new(buf, len);
                    free(buf);
                }
                close(p[0]);
                if(pid > 0){
                    for(;;){
                        w = wait();
                        if(w == nil)
                            break;
                        n = w->pid;
                        free(w);
                        if(n == pid)
                            break;
                    }
                }
            }
            free(cmd);
        }
    }
    return out;
}

function EnvGetRaw(string name) string {
    string out;
    c {
        char *n, *v;

        out = o9_string_new("", 0);
        n = o9_string_cstr(name);
        if(n != nil){
            v = getenv(n);
            if(v != nil){
                out = o9_string_from_c(v);
                free(v);
            }
            free(n);
        }
    }
    return out;
}

function EnvExistsRaw(string name) int64 {
    int64 out;
    c {
        char *n, *v;

        out = 0;
        n = o9_string_cstr(name);
        if(n != nil){
            v = getenv(n);
            if(v != nil){
                out = 1;
                free(v);
            }
            free(n);
        }
    }
    return out;
}

function EnvSetRaw(string name, string value) int64 {
    int64 out;
    c {
        char *n, *v;

        out = -1;
        n = o9_string_cstr(name);
        v = o9_string_cstr(value);
        if(n != nil && v != nil && n[0] != '\0' && strchr(n, '/') == nil)
            out = putenv(n, v);
        free(n);
        free(v);
    }
    return out;
}

function EnvUnsetRaw(string name) int64 {
    int64 out;
    c {
        char *n;
        char path[256];

        out = -1;
        n = o9_string_cstr(name);
        if(n != nil && n[0] != '\0' && strchr(n, '/') == nil){
            snprint(path, sizeof path, "/env/%s", n);
            out = remove(path);
        }
        free(n);
    }
    return out;
}

function EnvCwdRaw() string {
    string out;
    c {
        char buf[512];

        if(getwd(buf, sizeof buf) != nil)
            out = o9_string_from_c(buf);
        else
            out = o9_string_new("", 0);
    }
    return out;
}

function EnvChdirRaw(string path) int64 {
    int64 out;
    c {
        char *p;

        out = -1;
        p = o9_string_cstr(path);
        if(p != nil)
            out = chdir(p);
        free(p);
    }
    return out;
}

// Run an argv vector with stdin/stdout/stderr redirected to memory/files.
// argvText is NUL-separated: program\0arg0\0arg1\0...
function ProcessRunCaptureRaw(string argvText, string input, string outPath, string errPath) string {
    string out;
    c {
        char *args, *copy, *p, *end, *op, *ep;
        char statusbuf[ERRMAX];
        char **argv;
        int argc, in[2], ofd, efd, pid, n;
        vlong len, off;
        Waitmsg *w;

        out = o9_string_new("", 0);
        statusbuf[0] = 0;
        args = o9_string_data(argvText);
        len = o9_string_len(argvText);
        copy = malloc(len + 1);
        if(copy == nil){
            out = o9_string_from_c("out of memory");
            goto process_capture_done;
        }
        memmove(copy, args, len);
        copy[len] = 0;
        argv = malloc(64 * sizeof(char*));
        if(argv == nil){
            free(copy);
            out = o9_string_from_c("out of memory");
            goto process_capture_done;
        }
        argc = 0;
        p = copy;
        end = copy + len;
        while(p < end && argc < 63){
            argv[argc++] = p;
            p += strlen(p) + 1;
        }
        argv[argc] = nil;
        if(argc == 0){
            free(argv);
            free(copy);
            out = o9_string_from_c("empty argv");
            goto process_capture_done;
        }
        op = o9_string_cstr(outPath);
        ep = o9_string_cstr(errPath);
        ofd = create(op, OWRITE, 0600);
        efd = create(ep, OWRITE, 0600);
        free(op);
        free(ep);
        if(ofd < 0 || efd < 0 || pipe(in) < 0){
            if(ofd >= 0) close(ofd);
            if(efd >= 0) close(efd);
            free(argv);
            free(copy);
            out = o9_string_from_c("cannot set up process");
            goto process_capture_done;
        }
        pid = rfork(RFPROC|RFFDG|RFNOTEG);
        if(pid == 0){
            close(in[1]);
            dup(in[0], 0);
            close(in[0]);
            dup(ofd, 1);
            dup(efd, 2);
            close(ofd);
            close(efd);
            exec(argv[0], argv);
            exits("exec");
        }
        close(in[0]);
        off = 0;
        while(off < o9_string_len(input)){
            n = write(in[1], o9_string_data(input) + off,
                o9_string_len(input) - off);
            if(n <= 0)
                break;
            off += n;
        }
        close(in[1]);
        close(ofd);
        close(efd);
        if(pid > 0){
            for(;;){
                w = wait();
                if(w == nil)
                    break;
                if(w->pid == pid){
                    if(w->msg != nil)
                        snprint(statusbuf, sizeof statusbuf, "%s", w->msg);
                    free(w);
                    break;
                }
                free(w);
            }
        }
        out = o9_string_from_c(statusbuf);
        free(argv);
        free(copy);
process_capture_done:
        ;
    }
    return out;
}

class CmdResult {
    prop bool ok;
    prop string status;
    prop string out;
    prop string err;

    method CmdResult(bool success, string st, string o, string e) {
        ok = success;
        status = st;
        out = o;
        err = e;
    }

    method bool failed() {
        return !ok;
    }

    method string output() {
        return out;
    }

    method string error() {
        return err;
    }
}

class Cmd {
    prop string program;
    prop list<string> args;
    prop string input;

    method Cmd(string p) {
        program = p;
        args = new list<string>();
        input = "";
    }

    method void arg(string a) {
        args.add(a);
    }

    method void stdin(string data) {
        input = data;
    }

    method CmdResult run() {
        Buffer argv = new Buffer("");
        int64 i = 0;
        string base = cat("/tmp/o9cmd-", intstr(getpid()));
        string outPath = cat(base, "-out");
        string errPath = cat(base, "-err");
        argv.append(program);
        argv.appendByte(0);
        while(i < args.length()) {
            argv.append(args.get(i));
            argv.appendByte(0);
            i = i + 1;
        }
        Task<string> t = spawn ProcessRunCaptureRaw(argv.text(), input,
                                                    outPath, errPath);
        string status = t.await();
        string out = readfile(outPath);
        string err = readfile(errPath);
        removefile(outPath);
        removefile(errPath);
        CmdResult result = new CmdResult(len(status) == 0, status, out, err);
        return result;
    }
}

// A pipeline is expressed as a shell command string; callers are responsible
// for quoting arguments. Use Cmd for direct argv execution.
class Pipeline {
    prop string command;

    method Pipeline() {
        command = "";
    }

    method void add(string cmd) {
        if(len(command) > 0) {
            command = cat(command, " | ");
        }
        command = cat(command, cmd);
    }

    method CmdResult run() {
        string rc;
        Cmd c;

        rc = "/bin/rc";
        if(fileexists(rc) == 0) {
            string p9 = getenv("PLAN9");
            if(len(p9) > 0) {
                rc = cat(p9, "/bin/rc");
            }
        }
        if(fileexists(rc) == 0) {
            rc = "/usr/local/plan9/bin/rc";
        }
        c = new Cmd(rc);
        c.arg("-c");
        c.arg(command);
        return c.run();
    }
}

class Process {
    method int64 pid() {
        Task<int64> t = spawn ProcessPidRaw();
        return t.await();
    }

    method string user() {
        Task<string> t = spawn ProcessUserRaw();
        return t.await();
    }

    method int64 argc() {
        Task<int64> t = spawn ProcessArgcRaw();
        return t.await();
    }

    method string arg(int64 index) {
        Task<string> t = spawn ProcessArgRaw(index);
        return t.await();
    }

    method int64 run(string command) {
        Task<int64> t = spawn ProcessRunRaw(command);
        return t.await();
    }

    method string output(string command) {
        Task<string> t = spawn ProcessOutputRaw(command);
        return t.await();
    }
}

class Env {
    method string get(string name) {
        Task<string> t = spawn EnvGetRaw(name);
        return t.await();
    }

    method bool exists(string name) {
        Task<int64> t = spawn EnvExistsRaw(name);
        return t.await() == 1;
    }

    method bool set(string name, string value) {
        Task<int64> t = spawn EnvSetRaw(name, value);
        return t.await() == 0;
    }

    method bool unset(string name) {
        Task<int64> t = spawn EnvUnsetRaw(name);
        return t.await() == 0;
    }

    method string cwd() {
        Task<string> t = spawn EnvCwdRaw();
        return t.await();
    }

    method bool chdir(string path) {
        Task<int64> t = spawn EnvChdirRaw(path);
        return t.await() == 0;
    }
}
