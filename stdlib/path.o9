function PathCleanRaw(string path) string {
    string out;

    c {
        O9DataFrame f;
        char *p;

        o9_frame_enter(&f, nil);
        p = o9_frame_scratch_str(&f, path);
        cleanname(p);
        out = o9_string_from_c(p);
        o9_frame_exit(&f);
    }
    return out;
}

function PathBaseRaw(string path) string {
    string out;

    c {
        O9DataFrame f;
        char *p, *b;

        o9_frame_enter(&f, nil);
        p = o9_frame_scratch_str(&f, path);
        cleanname(p);
        b = strrchr(p, '/');
        if(b == nil)
            b = p;
        else if(b[1] != '\0')
            b++;
        out = o9_string_from_c(b);
        o9_frame_exit(&f);
    }
    return out;
}

function PathDirRaw(string path) string {
    string out;

    c {
        O9DataFrame f;
        char *p, *b;

        o9_frame_enter(&f, nil);
        p = o9_frame_scratch_str(&f, path);
        cleanname(p);
        b = strrchr(p, '/');
        if(b == nil)
            out = o9_string_from_c(".");
        else if(b == p)
            out = o9_string_from_c("/");
        else
            out = o9_string_new(p, b - p);
        o9_frame_exit(&f);
    }
    return out;
}

function PathExtRaw(string path) string {
    string out;

    c {
        O9DataFrame f;
        char *p, *b, *dot;

        o9_frame_enter(&f, nil);
        p = o9_frame_scratch_str(&f, path);
        cleanname(p);
        b = strrchr(p, '/');
        if(b == nil)
            b = p;
        else
            b++;
        dot = strrchr(b, '.');
        if(dot != nil && dot != b)
            out = o9_string_from_c(dot);
        else
            out = o9_string_from_c("");
        o9_frame_exit(&f);
    }
    return out;
}

function PathJoinRaw(string left, string right) string {
    string out;

    c {
        O9DataFrame f;
        char *l, *r, *buf;
        vlong n;

        o9_frame_enter(&f, nil);
        l = o9_string_data(left);
        r = o9_frame_scratch_str(&f, right);

        if(r[0] == '/'){
            cleanname(r);
            out = o9_string_from_c(r);
        } else {
            n = (left != nil ? left->len : 0) + (right != nil ? right->len : 0) + 2;
            buf = o9_frame_alloc(&f, n, 1);
            if(buf != nil){
                if(l == nil || l[0] == '\0')
                    snprint(buf, n, "%s", r);
                else
                    snprint(buf, n, "%s/%s", l, r);
                cleanname(buf);
                out = o9_string_from_c(buf);
            } else {
                out = o9_string_from_c("");
            }
        }
        o9_frame_exit(&f);
    }
    return out;
}

class Path {
    prop string value;

    method Path(string path) {
        value = path;
    }

    method void set(string path) {
        value = path;
    }

    method string text() {
        return value;
    }

    method string clean() {
        Task<string> t = spawn PathCleanRaw(value);
        return t.await();
    }

    method void normalize() {
        value = clean();
    }

    method string base() {
        Task<string> t = spawn PathBaseRaw(value);
        return t.await();
    }

    method string dir() {
        Task<string> t = spawn PathDirRaw(value);
        return t.await();
    }

    method string ext() {
        Task<string> t = spawn PathExtRaw(value);
        return t.await();
    }

    method string join(string child) {
        Task<string> t = spawn PathJoinRaw(value, child);
        return t.await();
    }

    method void append(string child) {
        value = join(child);
    }
}
