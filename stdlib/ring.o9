// ring.o9 — consistent-hashing ring for distributed placement.
//
// Maps a key to the node that owns it, by arithmetic rather than by
// asking a coordinator. Every node that agrees on the membership list
// computes the same answer, so there is no metadata server, no claim
// race, and no lookup round trip.
//
// The classic problem this solves: with `node = hash(key) % n`, adding
// one node remaps almost every key. On a ring, each node occupies
// several fixed positions in a circular keyspace and a key belongs to
// the first node clockwise of it, so adding or removing a node moves
// only the keys in the arcs that changed — about 1/n of them. Nothing
// else has to be told anything.
//
// Placement is derived from BLAKE2b (the `hash` builtin), so the ring
// is stable across machines, architectures, and runs: the same name
// and the same membership always give the same owner.
//
// Usage:
//     Ring r = new Ring(3);          // 3 replicas per node
//     r.addNode("dev9p");
//     r.addNode("authomatic");
//     string owner = r.owner("mutant.4711");
//     string backup = r.successor("mutant.4711", 1);
//
// Vnodes: each node is placed at `replicas` positions rather than one.
// With a single position per node the arcs come out badly uneven — a
// handful of nodes end up owning most of the keyspace. More vnodes
// smooth the distribution at the cost of a longer position list; 64 to
// 256 is the usual range for real clusters, and the default here is
// deliberately small so tests stay legible.

import "collections.o9";

// Name of a node's nth vnode: "<node>#<n>".
//
// The vnode names must differ from each other and from the bare node
// name, or every vnode would hash to the same position and the ring
// would degenerate to one point per node.
function RingVnodeNameRaw(string node, int64 n) string {
    string out;

    c {
        char *p;
        char buf[512];

        out = o9_string_new("", 0);
        p = o9_string_cstr(node);
        if(p != nil){
            snprint(buf, sizeof buf, "%s#%lld", p, n);
            out = o9_string_from_c(buf);
            free(p);
        }
    }

    return out;
}

// Fold a hex digest into a positive int64 ring position.
//
// `hash` returns a 64-char lowercase hex string; we take the first 15
// nibbles (60 bits) so the value always stays positive in a signed
// int64 and never depends on sign-extension behaviour. 60 bits of
// keyspace is far more than enough to keep positions distinct.
function RingPositionRaw(string name) int64 {
    string digest;
    int64 pos;

    digest = hash(name);
    pos = 0;

    c {
        char *p;
        int i;
        vlong v;
        int d;

        v = 0;
        p = o9_string_cstr(digest);
        if(p != nil){
            for(i = 0; i < 15 && p[i] != '\0'; i++){
                d = p[i];
                if(d >= '0' && d <= '9')
                    d = d - '0';
                else if(d >= 'a' && d <= 'f')
                    d = d - 'a' + 10;
                else if(d >= 'A' && d <= 'F')
                    d = d - 'A' + 10;
                else
                    d = 0;
                v = (v << 4) | d;
            }
            free(p);
        }
        pos = v;
    }

    return pos;
}

// One position on the ring: a vnode of some real node.
class RingSlot {
    int64 pos;
    string node;

    method RingSlot(int64 p, string n) {
        pos = p;
        node = n;
    }

    method int64 position() {
        return pos;
    }

    method string name() {
        return node;
    }
}

class Ring {
    private list<RingSlot> slots;
    private list<string> nodes;
    private int64 replicas;

    // `vnodes` is the positions per node. Higher means a more even
    // spread and a longer slot list. Values below 1 are clamped to 1,
    // since a node with no positions could never own anything.
    method Ring(int64 vnodes) {
        slots = new list<RingSlot>();
        nodes = new list<string>();
        replicas = vnodes;
        if (replicas < 1) {
            replicas = 1;
        }
    }

    method int64 vnodes() {
        return replicas;
    }

    method int64 nodeCount() {
        return nodes.length();
    }

    method int64 slotCount() {
        return slots.length();
    }

    // Is this node already a member? Membership is by exact name.
    method bool has(string name) {
        int64 i = 0;
        while (i < nodes.length()) {
            if (cmp(nodes.get(i), name) == 0) {
                return true;
            }
            i = i + 1;
        }
        return false;
    }

    method string nodeAt(int64 index) {
        if (index < 0) {
            return "";
        }
        if (index >= nodes.length()) {
            return "";
        }
        return nodes.get(index);
    }

    // Add a node, placing `replicas` vnodes around the ring. Adding a
    // node that is already present is a no-op rather than an error, so
    // replaying a membership log is idempotent — the same log applied
    // twice gives the same ring.
    method bool addNode(string name) {
        if (cmp(name, "") == 0) {
            return false;
        }
        if (has(name)) {
            return false;
        }

        nodes.add(name);

        int64 v = 0;
        while (v < replicas) {
            // Distinct vnode names give distinct, uncorrelated
            // positions for the same node.
            //
            // Functions are anonymous single-method objects, so a
            // direct call is illegal: spawn then await.
            Task<string> nt = spawn RingVnodeNameRaw(name, v);
            string vname = nt.await();
            Task<int64> pt = spawn RingPositionRaw(vname);
            int64 pos = pt.await();
            insertSlot(pos, name);
            v = v + 1;
        }
        return true;
    }

    // Insert a slot keeping the list sorted by position, so lookup can
    // scan in order and stop at the first slot clockwise of the key.
    private method void insertSlot(int64 pos, string name) {
        RingSlot slot = new RingSlot(pos, name);

        // Find the first slot clockwise of pos; that is where the new
        // one belongs. slots.length() means "past the end", i.e. append.
        int64 at = slots.length();
        int64 i = 0;
        while (i < slots.length()) {
            RingSlot cur = slots.get(i);
            if (cur.position() > pos) {
                if (at == slots.length()) {
                    at = i;
                }
            }
            i = i + 1;
        }

        // Grow by one, shift the tail right, drop the new slot in.
        // list<T> has add/set but no insert, and a void method cannot
        // return early, so this runs as one pass with no bare return.
        slots.add(slot);
        int64 j = slots.length() - 1;
        while (j > at) {
            slots.set(j, slots.get(j - 1));
            j = j - 1;
        }
        slots.set(at, slot);
    }

    // Remove a node and all of its vnodes. Keys in the arcs it owned
    // fall to the next node clockwise; no other key changes owner.
    method bool removeNode(string name) {
        if (!has(name)) {
            return false;
        }

        int64 i = 0;
        while (i < nodes.length()) {
            if (cmp(nodes.get(i), name) == 0) {
                nodes.remove(i);
            } else {
                i = i + 1;
            }
        }

        i = 0;
        while (i < slots.length()) {
            RingSlot cur = slots.get(i);
            if (cmp(cur.name(), name) == 0) {
                slots.remove(i);
            } else {
                i = i + 1;
            }
        }
        return true;
    }

    // The node owning `key`: the first slot clockwise of the key's
    // position, wrapping past the end of the ring back to the start.
    // Returns "" for an empty ring — callers must handle that rather
    // than assume an owner always exists.
    method string owner(string key) {
        if (slots.empty()) {
            return "";
        }

        Task<int64> pt = spawn RingPositionRaw(key);
        int64 pos = pt.await();
        int64 i = 0;
        while (i < slots.length()) {
            RingSlot cur = slots.get(i);
            if (cur.position() >= pos) {
                return cur.name();
            }
            i = i + 1;
        }
        // Past the last slot: wrap to the first.
        RingSlot first = slots.get(0);
        return first.name();
    }

    // The nth distinct node clockwise from the key's owner, for
    // replica placement and for failover when the owner is down.
    // successor(key, 0) is the owner. Distinct nodes are skipped to,
    // not distinct vnodes — otherwise several "replicas" could land on
    // one machine and the redundancy would be imaginary.
    //
    // Returns "" when the ring holds fewer than n+1 nodes.
    method string successor(string key, int64 n) {
        if (slots.empty()) {
            return "";
        }
        if (n < 0) {
            return "";
        }
        if (n >= nodes.length()) {
            return "";
        }

        Task<int64> spt = spawn RingPositionRaw(key);
        int64 pos = spt.await();

        // Index of the first slot at or clockwise of pos.
        int64 start = 0;
        bool found = false;
        int64 i = 0;
        while (i < slots.length()) {
            RingSlot cur = slots.get(i);
            if (cur.position() >= pos) {
                start = i;
                found = true;
                i = slots.length();
            } else {
                i = i + 1;
            }
        }
        if (!found) {
            start = 0;
        }

        list<string> seen = new list<string>();
        int64 step = 0;
        while (step < slots.length()) {
            int64 idx = start + step;
            while (idx >= slots.length()) {
                idx = idx - slots.length();
            }
            RingSlot cur = slots.get(idx);
            string cand = cur.name();

            bool dup = false;
            int64 s = 0;
            while (s < seen.length()) {
                if (cmp(seen.get(s), cand) == 0) {
                    dup = true;
                }
                s = s + 1;
            }

            if (!dup) {
                if (seen.length() == n) {
                    return cand;
                }
                seen.add(cand);
            }
            step = step + 1;
        }
        return "";
    }

    // The distinct nodes that should hold `key`: the owner plus the
    // next count-1 nodes clockwise. Fewer are returned when the ring
    // has fewer nodes than requested, so a caller can see it did not
    // get the redundancy it asked for.
    method list<string> replicaSet(string key, int64 count) {
        list<string> out = new list<string>();
        int64 i = 0;
        while (i < count) {
            string n = successor(key, i);
            if (cmp(n, "") == 0) {
                return out;
            }
            out.add(n);
            i = i + 1;
        }
        return out;
    }

    // Does `node` hold `key` at a replication factor of `count`?
    // The membership test a node runs against its own name to decide
    // whether it is responsible for a shard.
    method bool holds(string node, string key, int64 count) {
        list<string> set = replicaSet(key, count);
        int64 i = 0;
        while (i < set.length()) {
            if (cmp(set.get(i), node) == 0) {
                return true;
            }
            i = i + 1;
        }
        return false;
    }
}
